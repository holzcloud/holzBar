        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone élő tevékenységei a menüsoron maradnak, nem rejtődnek el. Kísérleti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitas Langsung dari iPhone Anda tetap berada di bar menu alih-alih disembunyikan. Eksperimental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Attività in tempo reale del tuo iPhone restano nella barra dei menu invece di essere nascoste. Sperimentale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone のライブアクティビティを非表示にせず、メニューバーに残します。試験的な機能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 실시간 현황이 숨겨지지 않고 메뉴 막대에 그대로 남습니다. 실험적 기능입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-activiteiten van je iPhone blijven in de menubalk in plaats van verborgen te worden. Experimenteel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywności na żywo z iPhone'a zostają na pasku menu zamiast być ukrywane. Eksperymentalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Atividades ao Vivo do seu iPhone permanecem na barra de menus em vez de ficarem ocultas. Experimental."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las activitads live da tes iPhone restan en la trav da menu empè da vegnir zuppentadas. Experimental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Живые активности» с вашего iPhone остаются в строке меню и не скрываются. Экспериментальная функция."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveaktiviteter från din iPhone stannar på menyraden i stället för att döljas. Experimentellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzdan gelen Canlı Etkinlikler gizlenmek yerine menü çubuğunda kalır. Deneysel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Живі активності» з вашого iPhone залишаються в смузі меню й не приховуються. Експериментальна функція."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 的“实时活动”会保留在菜单栏中，而不是被隐藏。实验性功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你 iPhone 上的「即時動態」會留在選單列中而不被隱藏。實驗性功能。"
          }
        }
      }
    },
