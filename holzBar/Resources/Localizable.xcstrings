    "Orange for the microphone, green for the camera. Uses no permission; holzBar cannot tell when an app records the screen." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oranžová pro mikrofon, zelená pro kameru. Nepotřebuje žádné oprávnění; holzBar nepozná, kdy aplikace nahrává obrazovku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orange für das Mikrofon, grün für die Kamera. Braucht keine Berechtigung; dass eine App den Bildschirm aufnimmt, kann holzBar nicht erkennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naranja para el micrófono, verde para la cámara. No usa ningún permiso; holzBar no puede saber cuándo una app graba la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orange pour le micro, vert pour la caméra. Aucune autorisation requise ; holzBar ne peut pas savoir quand une app enregistre l'écran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narancssárga a mikrofonhoz, zöld a kamerához. Nem használ engedélyt; a holzBar nem tudja, mikor rögzít egy alkalmazás képernyőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oranye untuk mikrofon, hijau untuk kamera. Tidak memakai izin; holzBar tidak tahu kapan app merekam layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arancione per il microfono, verde per la fotocamera. Non serve alcuna autorizzazione; holzBar non può sapere quando un'app registra lo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはオレンジ、カメラは緑です。権限は使いません。App が画面を収録しているかどうかは、holzBar にはわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크는 주황색, 카메라는 초록색입니다. 권한을 사용하지 않으며, holzBar는 앱이 화면을 기록하는지 알 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oranje voor de microfoon, groen voor de camera. Gebruikt geen toestemming; holzBar kan niet zien wanneer een app het scherm opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomarańczowy dla mikrofonu, zielony dla kamery. Nie używa żadnego uprawnienia; holzBar nie wie, kiedy aplikacja nagrywa ekran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laranja para o microfone, verde para a câmera. Não usa nenhuma permissão; o holzBar não consegue saber quando um app grava a tela."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oransch per il microfon, verd per la camera. Na dovra nagina permissiun; holzBar na po betg savair, cura ch'ina app registrescha il monitur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оранжевый — для микрофона, зелёный — для камеры. Разрешения не требуются; holzBar не может определить, когда приложение записывает экран."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orange för mikrofonen, grön för kameran. Använder ingen behörighet; holzBar vet inte när en app spelar in skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon için turuncu, kamera için yeşil. Hiçbir izin kullanmaz; holzBar bir uygulamanın ekranı ne zaman kaydettiğini bilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помаранчевий — для мікрофона, зелений — для камери. Дозволів не потрібно; holzBar не може визначити, коли програма записує екран."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风为橙色，摄像头为绿色。不使用任何权限；holzBar 无法得知某个 App 何时在录制屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "橙色代表麥克風，綠色代表相機。不需要任何權限；holzBar 無法得知 App 何時錄製螢幕。"
          }
        }
      }
    },
