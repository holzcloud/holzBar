    "Visible items that the notch hides, for example behind a long application menu, also appear in the holzBar Shelf." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viditelné položky, které výřez skrývá, například za dlouhou nabídkou aplikace, se zobrazí i v holzBar Shelf."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichtbare Elemente, die von der Notch verdeckt werden, etwa hinter einem langen App-Menü, erscheinen ebenfalls im holzBar Shelf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos visibles que el notch oculta, por ejemplo tras un menú de aplicación largo, también aparecen en el holzBar Shelf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments visibles que l'encoche cache, par exemple derrière un long menu d'app, apparaissent aussi dans le holzBar Shelf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi visibili nascosti dal notch, per esempio dietro un lungo menu di un'app, compaiono anche in holzBar Shelf."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチに隠れる表示中の項目（たとえば長いアプリケーションメニューの後ろにあるもの）も、holzBar Shelf に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에 가려진 표시 항목(예: 긴 앱 메뉴 뒤에 있는 항목)도 holzBar Shelf에 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zichtbare onderdelen die de notch verbergt, bijvoorbeeld achter een lang appmenu, verschijnen ook in de holzBar Shelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczne elementy, które notch zasłania, na przykład za długim menu aplikacji, pojawiają się też w holzBar Shelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens visíveis que o notch oculta, por exemplo atrás de um menu de aplicativo longo, também aparecem no holzBar Shelf."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elements visibels che la notch cuvra, per exempel davos in lung menu d'app, cumparan era en il holzBar Shelf."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видимые элементы, которые скрывает вырез (например, за длинным меню приложения), тоже появляются в holzBar Shelf."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被刘海遮住的可见项目（例如位于较长的 App 菜单后面的项目）也会显示在 holzBar Shelf 中。"
          }
        }
      }
    },
