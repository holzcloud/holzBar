            "value" : "Előbb mentsen egy elrendezésprofilt a Menüsor elrendezése panelen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan dulu profil tata letak di Tata Letak Bar Menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva prima un profilo di layout in «Layout della barra dei menu»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にメニューバーレイアウトでレイアウトプロファイルを保存してください。"
