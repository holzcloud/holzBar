          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona klavye kısayolu verebilmek için Menü Çubuğu Düzeni’nde bir düzen profili kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
