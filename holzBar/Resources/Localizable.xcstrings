          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve um perfil de layout no painel Layout da Barra de Menus para dar a ele um atalho de teclado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorisescha in profil da disposiziun en il champ «Disposiziun da la trav da menu» per al dar ina cumbinaziun da tastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните профиль раскладки на панели «Раскладка строки меню», чтобы назначить ему горячую клавишу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
