        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deactivà tenor standard, perquai che las AirPods sa disconnectan mintga giada ch’ellas turnan en lur cassa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
