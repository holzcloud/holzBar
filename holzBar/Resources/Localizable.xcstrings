    "Live Activities from your iPhone stay in the menu bar instead of being hidden. Experimental." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živé aktivity z iPhonu zůstanou v řádku nabídek místo skrytí. Experimentální."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivitäten deines iPhone bleiben in der Menüleiste, statt ausgeblendet zu werden. Experimentell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Actividades en directo de tu iPhone se quedan en la barra de menús en lugar de ocultarse. Experimental."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Activités en direct de votre iPhone restent dans la barre des menus au lieu d'être masquées. Expérimental."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Attività in tempo reale del tuo iPhone restano nella barra dei menu invece di essere nascoste. Sperimentale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone のライブアクティビティを非表示にせず、メニューバーに残します。試験的な機能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 실시간 현황이 숨겨지지 않고 메뉴 막대에 그대로 남습니다. 실험적 기능입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-activiteiten van je iPhone blijven in de menubalk in plaats van verborgen te worden. Experimenteel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywności na żywo z iPhone'a zostają na pasku menu zamiast być ukrywane. Eksperymentalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Atividades ao Vivo do seu iPhone permanecem na barra de menus em vez de ficarem ocultas. Experimental."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las activitads live da tes iPhone restan en la trav da menu empè da vegnir zuppentadas. Experimental."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Живые активности» с вашего iPhone остаются в строке меню и не скрываются. Экспериментальная функция."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 的“实时活动”会保留在菜单栏中，而不是被隐藏。实验性功能。"
