          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをディスプレイまたはスペースに関連付けると、そのディスプレイを接続したときやスペースに切り替えたときに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일을 디스플레이나 스페이스에 연결하면 해당 디스플레이를 연결하거나 그 스페이스로 전환할 때 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincule um perfil a um monitor ou a um Space para aplicá-lo ao conectar o monitor ou mudar para esse Space."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associescha in profil cun in monitur u in Space per l'applitgar, cura che ti colliaschas il monitur u midas al Space."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привяжите профиль к дисплею или рабочему столу, и он будет применяться при подключении дисплея или переключении на этот рабочий стол."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将配置文件绑定到显示器或空间，即可在连接该显示器或切换到该空间时应用它。"
          }
        }
      }
    },
