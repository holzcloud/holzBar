    "Drag to arrange your menu bar items into different sections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe deine Menüleistenelemente in die gewünschten Bereiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para organizar los elementos de tu barra de menús en distintas secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
