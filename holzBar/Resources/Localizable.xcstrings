    "When it stops being true, go back" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až přestane platit, vrátit zpět"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es nicht mehr zutrifft, zurückgehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando deje de cumplirse, volver atrás"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand ce n’est plus vrai, revenir en arrière"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha megszűnik igaznak lenni, visszaállítás"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat tidak lagi benar, kembalikan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando non è più vero, torna indietro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成立しなくなったら元に戻す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조건이 더 이상 참이 아니면 되돌리기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer het ophoudt waar te zijn, ga terug"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy przestaje być prawdziwe, wróć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando deixar de ser verdadeiro, voltar"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cura ch’i n’è betg pli vaira, turnar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда условие перестанет выполняться, вернуть как было"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det slutar stämma, ångra"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğru olmaktan çıkınca geri al"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли умова перестане виконуватися, повернути як було"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再成立时，恢复原状"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再成立時，恢復原狀"
          }
        }
      }
    },
    "When something happens, holzBar changes the menu bar for you. With no rules, nothing is observed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se něco stane, holzBar změní řádek nabídek za vás. Bez pravidel se nic nesleduje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn etwas passiert, passt holzBar die Menüleiste für dich an. Ohne Regeln wird nichts beobachtet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando ocurre algo, holzBar cambia la barra de menús por ti. Sin reglas, no se observa nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelque chose se produit, holzBar adapte la barre des menus pour vous. Sans règles, rien n’est observé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha történik valami, a holzBar módosítja a menüsort Ön helyett. Szabályok nélkül semmit sem figyel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat sesuatu terjadi, holzBar mengubah bar menu untuk Anda. Tanpa aturan, tidak ada yang dipantau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando succede qualcosa, holzBar adatta la barra dei menu per te. Senza regole non viene osservato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かが起きたときに、holzBar が代わりにメニューバーを変更します。ルールがない場合は、何も監視されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 일이 생기면 holzBar가 대신 메뉴 막대를 바꿉니다. 규칙이 없으면 아무것도 관찰하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer er iets gebeurt, past holzBar de menubalk voor je aan. Zonder regels wordt niets in de gaten gehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy coś się dzieje, holzBar zmienia pasek menu za Ciebie. Bez reguł nic nie jest obserwowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando algo acontece, o holzBar altera a barra de menus por você. Sem regras, nada é observado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cura che alchen capita, adatta holzBar la trav da menu per tai. Senza reglas na vegn observà nagut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда что-то происходит, holzBar меняет строку меню за вас. Если правил нет, ни за чем не наблюдает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
