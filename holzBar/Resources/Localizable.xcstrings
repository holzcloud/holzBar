    "%lld items will move, %lld are not in the menu bar now. The layout as it is now is kept first, so you can undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte werden verschoben, %lld sind jetzt nicht in der Menüleiste. Das jetzige Layout wird zuerst gesichert, damit du das rückgängig machen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments seront déplacés, %lld ne sont pas dans la barre des menus actuellement. La disposition actuelle est d’abord conservée, afin que vous puissiez annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi verranno spostati, %lld non sono ora nella barra dei menu. Il layout attuale viene prima conservato, così puoi annullare."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elements vegnan spustads, %lld n’èn ussa betg en la trav da menu. Il layout actual vegn l’emprim memorisà, uschè che ti pos revocar."
          }
        }
      }
    },
    "A display is connected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bildschirm ist angeschlossen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un écran est connecté"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno schermo è collegato"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In visur è collià"
          }
        }
      }
    },
    "A group puts several items behind an icon of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gruppe fasst mehrere Elemente hinter einem eigenen Symbol zusammen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un groupe réunit plusieurs éléments derrière une icône à lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gruppo raccoglie più elementi dietro un'icona propria."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ina gruppa unescha plirs elements davos in agen simbol."
          }
        }
      }
    },
    "A helper that works in the background" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Helfer, der im Hintergrund arbeitet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un assistant qui travaille en arrière-plan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un assistente che lavora in background"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In g’agid che lavura en il fund"
          }
        }
      }
    },
    "A menu bar shape draws the wallpaper beside the shape. holzBar reads most wallpapers from their file; a moving wallpaper can be read only with Screen Recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Menüleistenform zeichnet das Hintergrundbild neben der Form. holzBar liest die meisten Hintergrundbilder aus ihrer Datei; ein bewegtes Hintergrundbild lässt sich nur mit der Bildschirmaufnahme lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une forme de barre des menus dessine le fond d'écran à côté de la forme. holzBar lit la plupart des fonds d'écran dans leur fichier ; un fond d'écran animé ne se lit qu'avec l'enregistrement de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una forma della barra dei menu disegna lo sfondo accanto alla forma. holzBar legge la maggior parte degli sfondi dal loro file; uno sfondo animato si può leggere solo con la registrazione schermo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ina furma da la trav da menu dissegna il maletg dal fund sper la furma. holzBar legia la gronda part dals maletgs dal fund or da lur datoteca; in maletg dal fund en moviment sa lascha leger mo cun la Bildschirmaufnahme."
          }
        }
      }
    },
    "A profile with the same name is replaced. Apply it later from here, or with holzbar://profile/<name>." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Profil mit demselben Namen wird ersetzt. Wende es später hier an oder mit holzbar://profile/<name>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil du même nom est remplacé. Appliquez-le plus tard d'ici, ou avec holzbar://profile/<name>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profilo con lo stesso nome viene sostituito. Applicalo più tardi da qui o con holzbar://profile/<name>."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In profil cun il medem num vegn remplazzà. Applitgescha el pli tard da qua u cun holzbar://profile/<name>."
          }
        }
      }
    },
    "A system extra you rarely need on the bar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
