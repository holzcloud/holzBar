        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un profilo di layout nel pannello «Layout della barra dei menu» per assegnargli un'abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーレイアウトのパネルでレイアウトプロファイルを保存すると、ショートカットキーを割り当てられます。"
