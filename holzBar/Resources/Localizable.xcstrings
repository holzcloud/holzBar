    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nereaguje. Dokud se nespustí znovu, nelze ji přesunout. Do vyřešení se to může týkat i přesouvání ostatních položek řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht. Bis es neu gestartet wird, lässt es sich nicht verschieben. Bis dahin können auch andere Menüleistenelemente betroffen sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde. Mientras no se reinicie, no se puede mover. Hasta que se resuelva, también puede verse afectado el movimiento de otros elementos de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas. Tant qu'il n'est pas relancé, il ne peut pas être déplacé. Le déplacement d'autres éléments peut aussi en souffrir."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nem válaszol. Amíg újra nem indul, nem helyezhető át. A probléma megoldásáig más menüsor-elemek áthelyezése is érintett lehet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak merespons. Item ini tidak dapat dipindahkan sampai dimulai ulang. Pemindahan item bar menu lain mungkin terpengaruh sampai masalah teratasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Finché non viene riavviato non può essere spostato. Anche lo spostamento di altri elementi potrebbe risentirne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が応答していません。再起動するまで移動できません。解決するまで、他のメニューバー項目の移動にも影響が出る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않습니다. 다시 시작하기 전에는 이동할 수 없습니다. 문제가 해결될 때까지 다른 메뉴 막대 항목의 이동에도 영향이 있을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reageert niet. Totdat het opnieuw is gestart, kan het niet worden verplaatst. Ook het verplaatsen van andere menubalkonderdelen kan worden beïnvloed totdat dit is opgelost."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiada. Dopóki nie zostanie ponownie uruchomione, nie można go przenieść. Do czasu rozwiązania problemu może to wpływać także na przenoszenie innych elementów paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está respondendo. Enquanto não for reiniciado, não pode ser movido. Até que isso seja resolvido, a movimentação de outros itens da barra de menus também pode ser afetada."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ na reagescha betg. Fin ch'el vegn avià da nov, na sa lascha el betg spustar. Er auters elements pon esser pertutgads fin lura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отвечает. Пока приложение не перезапущено, его нельзя переместить. Пока проблема не решена, перемещение других элементов строки меню также может не работать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ svarar inte. Den kan inte flyttas förrän den startas om. Att flytta andra menyradsobjekt kan påverkas tills det är löst."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yanıt vermiyor. Yeniden başlatılana kadar taşınamaz. Çözülene kadar diğer menü çubuğu öğelerinin taşınması etkilenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не відповідає. Доки програму не перезапущено, її не можна перемістити. Доки проблему не усунено, переміщення інших елементів смуги меню також може не працювати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。在重新启动之前无法移动它。在问题解决之前，其他菜单栏项目的移动也可能受到影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有回應。在重新啟動之前，無法移動它。在問題解決之前，其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },
