        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 모드로 레이아웃 프로파일을 적용하려면 시스템 설정에서 해당 집중 모드에 holzBar 필터를 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicar um perfil de layout com um Foco, adicione o filtro do holzBar a esse Foco em Ajustes do Sistema."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per applitgar in profil da layout cun in focus, agiuntescha il filter holzBar a quest focus en las preferenzas dal sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы применять профиль раскладки через режим фокусирования, добавьте фильтр holzBar к этому режиму в «Системных настройках»."
