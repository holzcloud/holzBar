    "Not needed on macOS 27, which folds items that do not fit behind its own overflow button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter macOS 27 nicht nötig: Elemente, die nicht passen, landen dort hinter einer eigenen Überlauftaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutile sous macOS 27, qui replie les éléments qui ne tiennent pas derrière son propre bouton de débordement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve su macOS 27, che raccoglie gli elementi che non ci stanno dietro un proprio pulsante di overflow."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betg necessari sut macOS 27 che metta ils elements che n'han betg plazza davos in agen buttun da surpli."
          }
        }
      }
    },
    "Notch and Screen" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch und Bildschirm"
          }
        },
        "fr" : {
