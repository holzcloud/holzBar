    "Right-click in an empty area of the menu bar to display a minimal version of holzBar's menu. Disable this setting if you encounter conflicts with other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick auf eine leere Stelle der Menüleiste zeigt eine kurze Version des holzBar-Menüs. Deaktiviere diese Einstellung bei Konflikten mit anderen Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en un área vacía de la barra de menús para mostrar una versión mínima del menú de holzBar. Desactiva este ajuste si tienes conflictos con otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic droit dans une zone vide de la barre des menus affiche une version réduite du menu de holzBar. Désactivez ce réglage en cas de conflit avec d'autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il clic destro in un'area vuota della barra dei menu mostra una versione ridotta del menu di holzBar. Disattiva questa impostazione in caso di conflitti con altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分を右クリックすると、holzBar のメニューの簡易版が表示されます。他の App と競合する場合は、この設定をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역을 오른쪽 클릭하면 holzBar 메뉴의 간소화된 버전이 표시됩니다. 다른 앱과 충돌하면 이 설정을 끄세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma área vazia da barra de menus para exibir uma versão mínima do menu do holzBar. Desative este ajuste se tiver conflitos com outros apps."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In clic dretg en ina zona vida da la trav da menu mussa ina versiun curta dal menu da holzBar. Deactivescha quest parameter, sch'i dat conflicts cun autras apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите правой кнопкой на пустой области строки меню, чтобы показать сокращённую версию меню holzBar. Отключите этот параметр, если возникают конфликты с другими приложениями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏的空白区域右键点按，可显示 holzBar 菜单的精简版本。如果与其他 App 发生冲突，请关闭此设置。"
          }
        }
      }
    },
