    "Applies to items holzBar has not seen before. Items that are already arranged stay where they are." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro položky, které holzBar dosud neviděl. Položky, které už jsou uspořádané, zůstanou tam, kde jsou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für Elemente, die holzBar noch nicht kennt. Bereits angeordnete Elemente bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los elementos que holzBar no ha visto antes. Los elementos ya ordenados se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique aux éléments que holzBar n'a encore jamais vus. Les éléments déjà disposés restent où ils sont."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azokra az elemekre vonatkozik, amelyeket a holzBar még nem látott. A már elrendezett elemek a helyükön maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk item yang belum pernah dilihat holzBar. Item yang sudah ditata tetap di tempatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per gli elementi che holzBar non ha ancora visto. Gli elementi già sistemati restano dove sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar がまだ見たことのない項目に適用されます。すでに配置済みの項目はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
