    "Opens per day, oldest first. This is everything holzBar keeps." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevření za den, od nejstarších. To je vše, co holzBar uchovává."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnungen pro Tag, die ältesten zuerst. Das ist alles, was holzBar speichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperturas por día, de las más antiguas a las más recientes. Esto es todo lo que holzBar guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvertures par jour, les plus anciennes d’abord. C’est tout ce que holzBar conserve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperture al giorno, le più vecchie per prime. È tutto ciò che holzBar conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 日あたりの開いた回数を、古い順に表示しています。holzBar が保持しているのはこれがすべてです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루당 열기 횟수를 오래된 순서로 표시합니다. holzBar가 보관하는 것은 이것이 전부입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent per dag, oudste eerst. Dit is alles wat holzBar bewaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwarcia dziennie, od najstarszych. To wszystko, co przechowuje holzBar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aberturas por dia, das mais antigas às mais recentes. Isto é tudo o que o holzBar guarda."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertiras per di, las pli veglias l’emprim. Quai è tut ce che holzBar memorisescha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытия по дням, от самых старых к новым. Это всё, что хранит holzBar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的打开次数，从最早的开始。这就是 holzBar 保存的全部内容。"
          }
        }
      }
    },
