    "Give a menu bar item its own hotkey with Set Hotkey… in its menu in the Menu Bar Layout pane." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einem Menüleistenelement mit «Tastenkürzel festlegen …» in seinem Menü im Bereich «Menüleistenlayout» ein eigenes Tastenkürzel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a un elemento de la barra de menús su propio atajo de teclado con Definir atajo de teclado… en su menú, en el panel Disposición de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attribuez un raccourci à un élément avec « Définir un raccourci… » dans son menu, dans la sous-fenêtre « Disposition de la barre des menus »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna un'abbreviazione a un elemento con «Imposta abbreviazione…» nel suo menu, nel pannello «Layout della barra dei menu»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目専用のショートカットキーは、メニューバーレイアウトのパネルにあるその項目のメニューの「ショートカットキーを設定…」から設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 레이아웃 패널에서 메뉴 막대 항목의 메뉴에 있는 “단축키 설정…”을 사용해 해당 항목에 고유한 단축키를 지정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a um item da barra de menus o próprio atalho de teclado com Definir atalho de teclado… no menu dele, no painel Layout da Barra de Menus."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dà ad in element da la trav da menu ina atgna cumbinaziun da tastas cun «Definir la cumbinaziun …» en ses menu en il champ «Disposiziun da la trav da menu»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначьте элементу строки меню собственную горячую клавишу командой «Назначить горячую клавишу…» в его меню на панели «Раскладка строки меню»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“菜单栏布局”面板中，通过菜单栏项目菜单里的“设置快捷键…”，可以为该项目指定专属快捷键。"
          }
        }
      }
    },
