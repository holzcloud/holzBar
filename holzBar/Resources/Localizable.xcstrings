        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf는 항상 숨김 항목을 하나의 타일 뒤에 표시합니다. 타일을 클릭하면 열립니다."
          }
        },
        "nl" : {
