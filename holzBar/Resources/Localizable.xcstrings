    "Applications with a hidden item that are closed appear dimmed in the holzBar Shelf. Click one to open it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se skrytou položkou, které jsou zavřené, se v holzBar Shelf zobrazí ztlumeně. Kliknutím ji otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschlossene Apps mit einem ausgeblendeten Element erscheinen abgeblendet im holzBar Shelf. Ein Klick öffnet die App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones con un elemento oculto que están cerradas aparecen atenuadas en el holzBar Shelf. Haz clic en una para abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications fermées qui ont un élément masqué apparaissent estompées dans le holzBar Shelf. Un clic ouvre l'application."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rejtett elemmel rendelkező, bezárt alkalmazások halványan jelennek meg a holzBar Shelfben. Kattintson egyre a megnyitásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App yang ditutup dan memiliki item tersembunyi tampak redup di holzBar Shelf. Klik salah satunya untuk membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app chiuse con un elemento nascosto appaiono attenuate nel holzBar Shelf. Un clic apre l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示の項目があり、起動していない App は、holzBar Shelf に薄く表示されます。クリックすると開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨진 항목이 있는 앱이 종료되어 있으면 holzBar Shelf에 흐리게 표시됩니다. 클릭하면 해당 앱이 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps met een verborgen onderdeel die zijn gesloten, verschijnen gedimd in de holzBar Shelf. Klik op een app om hem te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje z ukrytym elementem, które są zamknięte, wyglądają na przyciemnione w holzBar Shelf. Kliknij jedną, aby ją otworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aplicativos com um item oculto que estão fechados aparecem esmaecidos no holzBar Shelf. Clique em um para abri-lo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las applicaziuns serradas cun in element zuppà cumparan sfumadas en il holzBar Shelf. Ina clicada avra l'applicaziun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытые приложения со скрытым элементом отображаются в holzBar Shelf затемнёнными. Нажмите на одно из них, чтобы открыть его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stängda appar med ett dolt objekt visas nedtonade i holzBar Shelf. Klicka på en för att öppna den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizli öğesi olan kapalı uygulamalar holzBar Shelf içinde soluk görünür. Açmak için birine tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закриті програми з прихованим елементом відображаються в holzBar Shelf затемненими. Клацніть одну з них, щоб відкрити її."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带有隐藏项目但未运行的 App 会在 holzBar Shelf 中以灰色显示。点按其中一个即可打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有隱藏項目但已關閉的 App 會在 holzBar Shelf 中顯示為變暗。按一下其中一個即可打開。"
          }
        }
      }
    },
