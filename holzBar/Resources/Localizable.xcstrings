            "value" : "Fluida"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スムーズ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드럽게"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suave"
          }
        },
