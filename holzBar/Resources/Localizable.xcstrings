        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zachowaj profil układu w Układzie paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
