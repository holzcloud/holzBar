        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름이 같은 프로파일은 대체됩니다. 나중에 여기에서 또는 holzbar://profile/<name>(으)로 적용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um perfil com o mesmo nome é substituído. Aplique-o depois aqui ou com holzbar://profile/<name>."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In profil cun il medem num vegn remplazzà. Applitgescha el pli tard da qua u cun holzbar://profile/<name>."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль с тем же именем будет заменён. Применить его позже можно отсюда или по ссылке holzbar://profile/<name>."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
