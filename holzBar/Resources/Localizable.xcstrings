    "Save a layout profile in Menu Bar Layout first." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív uložte profil uspořádání v Uspořádání řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere zuerst ein Layoutprofil unter «Menüleistenlayout»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda primero un perfil de disposición en Disposición de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez d’abord un profil de disposition dans « Disposition de la barre des menus »."
