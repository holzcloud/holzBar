            "value" : "Non è stato possibile leggerlo, oppure contiene qualcosa che un profilo non può contenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取れなかったか、プロファイルに含められない内容が含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽을 수 없거나, 프로파일에 포함할 수 없는 내용이 들어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kon niet worden gelezen of bevat iets wat een profiel niet mag bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się go odczytać lub zawiera coś, czego profil nie może zawierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível lê-lo, ou ele contém algo que um perfil não pode conter."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ella n’ha betg pudì vegnir legida u cuntegna insatge che in profil na dastga betg cuntegnair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать файл, или в нём есть то, чего не может быть в профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
