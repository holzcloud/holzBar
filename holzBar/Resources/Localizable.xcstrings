    "Timers, countdowns and a stopwatch at the notch, with a sound when a timer ends." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovače, odpočty a stopky u výřezu, se zvukem po skončení časovače."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, Countdowns und eine Stoppuhr an der Notch, mit einem Ton, wenn ein Timer endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporizadores, cuentas atrás y un cronómetro en el notch, con un sonido cuando termina un temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuteurs, comptes à rebours et chronomètre à l’encoche, avec un son à la fin d’un minuteur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Időzítők, visszaszámlálások és stopper a notchnál, hanggal az időzítő végén."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, hitung mundur, dan stopwatch di notch, dengan suara saat timer berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, conti alla rovescia e cronometro al notch, con un suono quando un timer termina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチにタイマー、カウントダウン、ストップウォッチを表示します。タイマーが終了すると音が鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에서 타이머, 카운트다운, 스톱워치를 사용합니다. 타이머가 끝나면 소리가 납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timers, aftellers en een stopwatch bij de notch, met een geluid wanneer een timer afloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutniki, odliczania i stoper przy notchu, z dźwiękiem po zakończeniu minutnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporizadores, contagens regressivas e um cronômetro no notch, com um som quando um temporizador termina."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporisaders, conts a l’enviers ed in cronometer tar la notch, cun in tun cur ch’in temporisader finescha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймеры, обратный отсчёт и секундомер у выреза; когда таймер заканчивается, звучит сигнал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timers, nedräkningar och ett stoppur vid notchen, med ett ljud när timern är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch’ta zamanlayıcılar, geri sayımlar ve bir kronometre; zamanlayıcı bittiğinde bir sesle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймери, зворотний відлік і секундомір біля вирізу; коли таймер закінчується, лунає сигнал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在刘海处使用计时器、倒计时和秒表，计时器结束时会发出提示音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏海旁顯示計時器、倒數與碼錶，計時器結束時會播放聲音。"
          }
        }
      }
    },
