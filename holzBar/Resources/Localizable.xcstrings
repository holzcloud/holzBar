    "macOS 27 hides whole apps, and holzBar can't tell which app this item belongs to." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 skrývá celé aplikace a holzBar nepozná, ke které aplikaci tato položka patří."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 blendet ganze Apps aus, und holzBar kann nicht erkennen, zu welcher App dieses Element gehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 oculta apps enteras, y holzBar no puede saber a qué app pertenece este elemento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 masque des apps entières, et holzBar ne sait pas à quelle app appartient cet élément."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS 27 egész alkalmazásokat rejt el, és a holzBar nem tudja, melyik alkalmazáshoz tartozik ez az elem."
