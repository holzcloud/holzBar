        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 메뉴 막대 항목을 여러 섹션으로 정리하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om je menubalkonderdelen in verschillende secties te ordenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągaj, aby ułożyć elementy paska menu w różnych sekcjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para organizar os itens da sua barra de menus em seções diferentes."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira ils elements da la trav da menu en las secziuns giavischadas."
          }
        },
        "ru" : {
          "stringUnit" : {
