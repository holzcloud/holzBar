        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На macOS 27 не требуется: элементы, которые не помещаются, система сворачивает за собственную кнопку переполнения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behövs inte på macOS 27, som viker objekt som inte får plats bakom sin egen överflödesknapp."
          }
