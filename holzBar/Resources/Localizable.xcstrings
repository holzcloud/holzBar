    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht. Bis es neu gestartet wird, lässt es sich nicht verschieben. Bis dahin können auch andere Menüleistenelemente betroffen sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde. Mientras no se reinicie, no se puede mover. Hasta que se resuelva, también puede verse afectado el movimiento de otros elementos de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas. Tant qu'il n'est pas relancé, il ne peut pas être déplacé. Le déplacement d'autres éléments peut aussi en souffrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Finché non viene riavviato non può essere spostato. Anche lo spostamento di altri elementi potrebbe risentirne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が応答していません。再起動するまで移動できません。解決するまで、他のメニューバー項目の移動にも影響が出る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 응답하지 않습니다. 다시 시작하기 전에는 이동할 수 없습니다. 문제가 해결될 때까지 다른 메뉴 막대 항목의 이동에도 영향이 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está respondendo. Enquanto não for reiniciado, não pode ser movido. Até que isso seja resolvido, a movimentação de outros itens da barra de menus também pode ser afetada."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ na reagescha betg. Fin ch'el vegn avià da nov, na sa lascha el betg spustar. Er auters elements pon esser pertutgads fin lura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отвечает. Пока приложение не перезапущено, его нельзя переместить. Пока проблема не решена, перемещение других элементов строки меню также может не работать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。在重新启动之前无法移动它。在问题解决之前，其他菜单栏项目的移动也可能受到影响。"
          }
        }
      }
    },
