          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza, holzBar mostra le icone delle app. Puoi cambiarlo in qualsiasi momento in Impostazioni → Avanzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しない場合、holzBar は App のアイコンを表示します。この設定は、いつでも設定 → 詳細で変更できます。"
