    "holzBar could not restart itself. Quit holzBar and open it again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar se nepodařilo restartovat. Ukončete holzBar a otevřete ho znovu."
