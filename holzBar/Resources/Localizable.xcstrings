        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecter les clics, défilements et survols dans la barre des menus pour l'affichage au clic, au défilement et au survol."
          }
        },
        "it" : {
          "stringUnit" : {
