          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access holzBar's settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken, um ausgeblendete Menüleistenelemente einzublenden. Rechtsklick für die Einstellungen von holzBar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para mostrar los elementos ocultos de la barra de menús. Haz clic derecho para acceder a los ajustes de holzBar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
