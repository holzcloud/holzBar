    "A row holds every item side by side. A grid and a column hold more items without scrolling." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řada drží všechny položky vedle sebe. Mřížka a sloupec pojmou víc položek bez posouvání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reihe zeigt alle Elemente nebeneinander. Ein Raster und eine Spalte zeigen mehr Elemente ohne Scrollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fila contiene todos los elementos uno junto a otro. Una cuadrícula y una columna contienen más elementos sin desplazarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une rangée place tous les éléments côte à côte. Une grille et une colonne en montrent davantage sans défilement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy sor az összes elemet egymás mellett tartja. Egy rács és egy oszlop több elemet fér el görgetés nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris menempatkan semua item berdampingan. Kisi dan kolom memuat lebih banyak item tanpa menggulir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una riga mostra tutti gli elementi affiancati. Una griglia e una colonna ne mostrano di più senza scorrere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行にはすべての項目が横に並びます。グリッドと列なら、スクロールせずにより多くの項目を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행은 모든 항목을 나란히 놓습니다. 그리드와 열은 스크롤하지 않고도 더 많은 항목을 담을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rij houdt alle onderdelen naast elkaar. Een raster en een kolom bevatten meer onderdelen zonder te scrollen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rząd mieści wszystkie elementy obok siebie. Siatka i kolumna mieszczą więcej elementów bez przewijania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha contém todos os itens lado a lado. Uma grade e uma coluna comportam mais itens sem rolagem."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ina retscha mussa tut ils elements in sper l’auter. Ina grillia ed ina colonna mussan dapli elements senza scrollar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ряду все элементы лежат рядом. Сетка и столбец вмещают больше элементов без прокрутки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad håller alla objekt sida vid sida. Ett rutnät och en kolumn rymmer fler objekt utan rullning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir satır tüm öğeleri yan yana tutar. Izgara ve sütun kaydırmadan daha fazla öğe sığdırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У ряду всі елементи лежать поруч. Сітка й стовпець вміщують більше елементів без прокручування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单行会把所有项目并排放在一起。网格和单列无需滚动即可容纳更多项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「列」會把所有項目並排放置。「格狀」與「欄」可在不捲動的情況下容納更多項目。"
          }
        }
      }
    },
