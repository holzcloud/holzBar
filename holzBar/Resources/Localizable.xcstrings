    "Please try again. If the error persists, please file a bug report." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste to znovu. Pokud chyba přetrvává, nahlaste ji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versuche es nochmals. Wenn der Fehler bleibt, melde ihn bitte."
          }
        },
        "es" : {
          "stringUnit" : {
