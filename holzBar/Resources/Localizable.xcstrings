            "value" : "Ti pos agiuntar fin a dudesch widgets."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно добавить до двенадцати виджетов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可以添加十二个小组件。"
          }
        }
      }
    },
    "“%@” was put back in %@." : {
