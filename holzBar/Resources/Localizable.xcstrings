    "Older ones are deleted. Starred snapshots stay and are not counted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere werden gelöscht. Mit Stern markierte bleiben und zählen nicht mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las más antiguas se eliminan. Las instantáneas con estrella se quedan y no cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus anciens sont supprimés. Ceux marqués d’une étoile restent et ne sont pas comptés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle più vecchie vengono eliminate. Quelle con la stella restano e non vengono contate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いものは削除されます。スターを付けたスナップショットは残り、数には含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래된 것은 삭제됩니다. 별표를 표시한 스냅샷은 그대로 두며 개수에 포함되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mais antigos são excluídos. Os instantâneos com estrela permanecem e não são contados."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pli veglias vegnan stizzadas. Las cun stailla restan e na vegnan betg quintadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более старые удаляются. Отмеченные снимки сохраняются и не учитываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较旧的快照会被删除。加了星标的快照会保留，且不计入数量。"
          }
        }
      }
    },
