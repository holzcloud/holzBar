        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf pokazuje obrazy elementów paska menu, które macOS pozwala aplikacji robić tylko z uprawnieniem Nagrywanie ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar Shelf mostra imagens dos seus itens da barra de menus, que o macOS só permite a um app capturar com Gravação de Tela."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il holzBar Shelf mussa maletgs da tes elements da la trav da menu, ils quals macOS lascha far mo cun la Bildschirmaufnahme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf показывает изображения элементов вашей строки меню, а macOS позволяет приложению получать их только при наличии доступа к записи экрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf 会显示你的菜单栏项目的图像，macOS 只允许拥有“屏幕录制”权限的 App 截取这些图像。"
          }
        }
      }
    },
