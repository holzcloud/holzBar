          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez pour afficher les éléments masqués. Clic droit pour les réglages de holzBar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
