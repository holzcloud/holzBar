    "Save a layout profile in the Menu Bar Layout pane to give it a hotkey." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte profil uspořádání v podokně Uspořádání řádku nabídek, abyste mu mohli přidělit klávesovou zkratku."
