          }
        }
      }
    },
    "The search and the command palette reach Settings too." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledání a paleta příkazů dosáhnou i na nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch die Suche und die Befehlspalette führen zu den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda y la paleta de comandos también llegan a los Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche et la palette de commandes mènent aussi aux réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A keresés és a parancspaletta a beállításokat is eléri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencarian dan palet perintah juga menjangkau pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche la ricerca e la tavolozza dei comandi portano alle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索とコマンドパレットからも設定を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색과 명령 팔레트로도 설정을 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het zoeken en het opdrachtenpalet bereiken ook de instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie i paleta poleceń obejmują także ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A busca e a paleta de comandos também chegam aos Ajustes."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er la tschertga e la paletta da cumonds manan als parameters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск и палитра команд тоже открывают настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökningen och kommandopaletten når även inställningarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama ve komut paleti ayarlara da ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук і палітра команд також відкривають параметри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索和命令面板也可以打开“设置”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋與指令面板也能打開「設定」。"
          }
        }
      }
    },
