    "Hover over an empty area of the menu bar to show hidden menu bar items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najetím na prázdnou oblast řádku nabídek zobrazíte skryté položky řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Zeiger über eine leere Stelle der Menüleiste, um ausgeblendete Elemente einzublenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el puntero por un área vacía de la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il puntatore su un'area vuota della barra dei menu per mostrare gli elementi nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分にポインタを重ねると、非表示の項目が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역 위에 포인터를 올리면 숨겨진 항목이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg over een leeg gebied van de menubalk om verborgen menubalkonderdelen te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najedź na puste miejsce na pasku menu, aby pokazać ukryte elementy paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o ponteiro sobre uma área vazia da barra de menus para exibir os itens ocultos."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va cun il cursur sur ina zona vida da la trav da menu per mussar ils elements zuppads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите указатель на пустую область строки меню, чтобы показать скрытые элементы."
