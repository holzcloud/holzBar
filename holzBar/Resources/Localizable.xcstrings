    "macOS 27 doesn't let apps hide this system item." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 lässt Apps dieses Systemelement nicht ausblenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 ne permet pas aux apps de masquer cet élément système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 non consente alle app di nascondere questo elemento di sistema."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 na lubescha betg a las apps da zuppentar quest element dal sistem."
          }
        }
      }
    },
    "macOS 27 hides whole apps, and holzBar can't tell which app this item belongs to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 blendet ganze Apps aus, und holzBar kann nicht erkennen, zu welcher App dieses Element gehört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 masque des apps entières, et holzBar ne sait pas à quelle app appartient cet élément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 nasconde app intere e holzBar non riesce a capire a quale app appartiene questo elemento."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 zuppenta apps entiras, e holzBar na po betg percorscher a tge app ch'quest element tutga."
          }
        }
      }
    },
    "macOS did not accept this combination. Choose another one." : {
      "localizations" : {
