    "Uses no permission: holzBar notices a mirrored display and macOS's screen sharing agent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht keine Berechtigung: holzBar erkennt einen gespiegelten Bildschirm und den Bildschirmfreigabe-Agenten von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usa ningún permiso: holzBar detecta una pantalla duplicada y el agente de compartir pantalla de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune autorisation requise : holzBar détecte un écran recopié et l'agent de partage d'écran de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve alcuna autorizzazione: holzBar rileva un monitor duplicato e l'agente di condivisione schermo di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限は使いません。holzBar は、ミラーリングされたディスプレイと macOS の画面共有エージェントを検知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 사용하지 않습니다. holzBar는 미러링된 디스플레이와 macOS의 화면 공유 에이전트를 감지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não usa nenhuma permissão: o holzBar percebe um monitor espelhado e o agente de compartilhamento de tela do macOS."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dovra nagina permissiun: holzBar percorscha in monitur spievlà e l'agent da partiziun dal monitur da macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения не требуются: holzBar замечает дублированный дисплей и агент демонстрации экрана macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不使用任何权限：holzBar 会察觉镜像显示器以及 macOS 的屏幕共享代理。"
          }
        }
      }
    },
