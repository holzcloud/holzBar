    "“%@” already uses this combination. Use it here instead?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ už tuto kombinaci používá. Použít ji místo toho tady?"
          }
        },
        "de" : {
