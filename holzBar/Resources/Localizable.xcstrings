    "holzBar will replace its current settings with the ones from “%@” and restart." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar nahradí vaše aktuální nastavení nastavením z „%@“ a restartuje se."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar ersetzt seine aktuellen Einstellungen durch die aus «%@» und startet neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar reemplazará sus ajustes actuales por los de “%@” y se reiniciará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar remplacera ses réglages actuels par ceux de « %@ » et redémarrera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holzBar lecseréli a jelenlegi beállításait a(z) „%@” beállításaira, és újraindul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mengganti pengaturan Anda saat ini dengan pengaturan dari “%@” dan dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar sostituirà le impostazioni attuali con quelle di «%@» e si riavvierà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は現在の設定を「%@」の設定に置き換えて、再起動します。"
          }
        },
        "ko" : {
