    "%lld items will move, %lld are not in the menu bar now. The layout as it is now is kept first, so you can undo this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte werden verschoben, %lld sind jetzt nicht in der Menüleiste. Das jetzige Layout wird zuerst gesichert, damit du das rückgängig machen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se moverán %lld elementos; %lld no están ahora en la barra de menús. Primero se conserva la disposición actual, para que puedas deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments seront déplacés, %lld ne sont pas dans la barre des menus actuellement. La disposition actuelle est d’abord conservée, afin que vous puissiez annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi verranno spostati, %lld non sono ora nella barra dei menu. Il layout attuale viene prima conservato, così puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個の項目が移動し、%lld 個は現在メニューバーにありません。現在のレイアウトは先に保存されるので、元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 %lld개가 이동하고, %lld개는 지금 메뉴 막대에 없습니다. 현재 레이아웃이 먼저 보관되므로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens serão movidos; %lld não estão na barra de menus agora. O layout atual é mantido antes, para que você possa desfazer."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
