    "Needs Location Services. Until you allow holzBar, this condition is never true." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžaduje Polohové služby. Dokud holzBar nepovolíte, tato podmínka nikdy neplatí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht die Ortungsdienste. Solange du holzBar nicht erlaubst, trifft diese Bedingung nie zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita los Servicios de localización. Hasta que permitas a holzBar, esta condición nunca se cumple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite les services de localisation. Tant que vous n’autorisez pas holzBar, cette condition n’est jamais vraie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helymeghatározás szükséges. Amíg nem engedélyezi a holzBart, ez a feltétel soha nem teljesül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layanan Lokasi diperlukan. Sampai Anda mengizinkan holzBar, kondisi ini tidak pernah terpenuhi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede i Servizi di localizzazione. Finché non autorizzi holzBar, questa condizione non è mai vera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報サービスが必要です。holzBar を許可するまで、この条件は成立しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 서비스가 필요합니다. holzBar를 허용하기 전에는 이 조건이 참이 되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeft Locatievoorzieningen nodig. Totdat je holzBar toestemming geeft, is deze voorwaarde nooit waar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga Usług lokalizacji. Dopóki nie zezwolisz holzBar, ten warunek nigdy nie jest spełniony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requer os Serviços de Localização. Até que você permita o holzBar, esta condição nunca é verdadeira."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovra ils servetschs da localisaziun. Entant che ti na lubeschas betg holzBar, n’è questa cundiziun mai vaira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуются службы геолокации. Пока вы не разрешите holzBar, это условие никогда не выполняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platstjänster krävs. Tills du tillåter holzBar stämmer det här villkoret aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum Servisleri gerekli. holzBar’a izin verene kadar bu koşul asla sağlanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібні служби локації. Доки ви не дозволите holzBar, ця умова ніколи не виконується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“定位服务”。在你允许 holzBar 之前，此条件永远不会成立。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要定位服務。在你允許 holzBar 之前，此條件永遠不成立。"
          }
        }
      }
    },
