    "Your script settings could not be saved on this Mac. holzBar tries again at the next change." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení skriptů se na tomto Macu nepodařilo uložit. holzBar to zkusí znovu při další změně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Skript-Einstellungen konnten auf diesem Mac nicht gespeichert werden. holzBar versucht es bei der nächsten Änderung erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar los ajustes de tus scripts en este Mac. holzBar lo intenta de nuevo en el siguiente cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réglages de scripts n’ont pas pu être enregistrés sur ce Mac. holzBar réessaie à la prochaine modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni degli script non hanno potuto essere salvate su questo Mac. holzBar riprova alla prossima modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトの設定をこの Mac に保存できませんでした。holzBar は次の変更時にもう一度試みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 스크립트 설정을 저장할 수 없었습니다. holzBar는 다음 변경 때 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je scriptinstellingen konden niet op deze Mac worden bewaard. holzBar probeert het opnieuw bij de volgende wijziging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać ustawień skryptów na tym Macu. holzBar spróbuje ponownie przy następnej zmianie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar os ajustes dos seus scripts neste Mac. O holzBar tenta novamente na próxima alteração."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las parameters dals scrips n’han betg pudì vegnir memorisadas sin quest Mac. holzBar emprova puspè cun la proxima midada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить настройки ваших скриптов на этом Mac. holzBar повторит попытку при следующем изменении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在这台 Mac 上存储你的脚本设置。holzBar 会在下次更改时重试。"
          }
        }
      }
    },
    "Your scripts were set up by a newer holzBar. Nothing runs until you update holzBar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše skripty nastavila novější verze holzBar. Nic se nespustí, dokud holzBar neaktualizujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Skripte wurden von einer neueren holzBar-Version eingerichtet. Nichts läuft, bis du holzBar aktualisierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus scripts los configuró una versión más reciente de holzBar. No se ejecuta nada hasta que actualices holzBar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos scripts ont été configurés par une version plus récente de holzBar. Rien ne s’exécute tant que vous n’avez pas mis à jour holzBar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi script sono stati configurati da una versione più recente di holzBar. Non viene eseguito nulla finché non aggiorni holzBar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトは、より新しい holzBar で設定されています。holzBar をアップデートするまで、何も実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크립트가 더 최신 버전의 holzBar에서 설정되었습니다. holzBar를 업데이트하기 전에는 아무것도 실행되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je scripts zijn ingesteld door een nieuwere holzBar. Er draait niets totdat je holzBar bijwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje skrypty zostały skonfigurowane przez nowszy holzBar. Nic nie jest uruchamiane, dopóki nie zaktualizujesz holzBar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
