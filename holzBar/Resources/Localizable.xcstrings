{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is in front" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ im Vordergrund ist"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est au premier plan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in primo piano"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è en emprim plan"
          }
        }
      }
    },
    "%@ is running" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est ouvert"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funcziuna"
          }
        }
      }
    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reagiert nicht. Bis es neu gestartet wird, lässt es sich nicht verschieben. Bis dahin können auch andere Menüleistenelemente betroffen sein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne répond pas. Tant qu'il n'est pas relancé, il ne peut pas être déplacé. Le déplacement d'autres éléments peut aussi en souffrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non risponde. Finché non viene riavviato non può essere spostato. Anche lo spostamento di altri elementi potrebbe risentirne."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ na reagescha betg. Fin ch'el vegn avià da nov, na sa lascha el betg spustar. Er auters elements pon esser pertutgads fin lura."
          }
        }
      }
    },
