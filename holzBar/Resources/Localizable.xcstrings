    "A capsule below the notch names the accessory for five seconds." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsle pod výřezem pět sekund uvádí název příslušenství."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kapsel unter der Notch nennt das Zubehör fünf Sekunden lang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cápsula bajo el notch nombra el accesorio durante cinco segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une capsule sous l’encoche indique le nom de l’accessoire pendant cinq secondes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notch alatti kapszula öt másodpercig megnevezi a tartozékot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsul di bawah notch menyebutkan nama aksesori selama lima detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una capsula sotto il notch indica il nome dell’accessorio per cinque secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチの下のカプセルに、アクセサリの名前が 5 秒間表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 아래의 캡슐에 5초 동안 액세서리 이름이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een capsule onder de notch noemt het accessoire vijf seconden lang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsuła pod notchem przez pięć sekund pokazuje nazwę akcesorium."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cápsula abaixo do notch mostra o nome do acessório por cinco segundos."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In capsula sut la notch numna l’accessori durant tschintg secundas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Капсула под вырезом на пять секунд показывает название аксессуара."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kapsel under notchen anger tillbehörets namn i fem sekunder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch’un altındaki bir kapsül aksesuarın adını beş saniye gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Капсула під вирізом на пʼять секунд показує назву аксесуара."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海下方的胶囊会显示配件名称，持续五秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏海下方的膠囊會顯示配件名稱五秒鐘。"
          }
        }
      }
    },
    "A click opens AirDrop. Drop files on the icon to share them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutí otevře AirDrop. Přetažením souborů na ikonu je sdílíte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick öffnet AirDrop. Lege Dateien auf dem Symbol ab, um sie zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic abre AirDrop. Suelta archivos sobre el icono para compartirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic ouvre AirDrop. Déposez des fichiers sur l’icône pour les partager."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kattintás megnyitja az AirDropot. Húzzon fájlokat az ikonra a megosztásukhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu klik membuka AirDrop. Seret file ke ikon untuk membagikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic apre AirDrop. Trascina i file sull’icona per condividerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックすると AirDrop が開きます。ファイルをアイコンにドロップして共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 AirDrop이 열립니다. 아이콘에 파일을 드롭하여 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een klik opent AirDrop. Zet bestanden op het symbool om ze te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie otwiera AirDrop. Upuść pliki na ikonie, aby je udostępnić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um clique abre o AirDrop. Solte arquivos sobre o ícone para compartilhá-los."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In clic avra AirDrop. Tschenta datotecas sin l’icona per las parter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие открывает AirDrop. Перетащите файлы на значок, чтобы поделиться ими."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
