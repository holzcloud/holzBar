        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "허용하지 않으면 holzBar는 앱 아이콘을 표시합니다. 이 설정은 언제든지 설정 → 고급에서 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder toont holzBar de symbolen van de apps. Je kunt dit altijd wijzigen bij Instellingen → Geavanceerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego holzBar pokazuje ikony aplikacji. Możesz to zmienić w dowolnym momencie w Ustawienia → Zaawansowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem isso, o holzBar mostra os ícones dos apps. Você pode mudar isso a qualquer momento em Ajustes → Avançado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
