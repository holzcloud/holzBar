        }
      }
    },
    "The holzBar Shelf shows pictures of your menu bar items, which macOS lets an app take only with Screen Recording." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf zobrazuje obrázky položek řádku nabídek, které macOS aplikaci dovolí pořídit jen se Záznamem obrazovky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das holzBar Shelf zeigt Bilder deiner Menüleistenelemente, die eine App unter macOS nur mit der Bildschirmaufnahme erstellen darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El holzBar Shelf muestra imágenes de tus elementos de la barra de menús, que macOS solo permite tomar a una app con Grabación de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le holzBar Shelf affiche des images de vos éléments de la barre des menus, que macOS ne laisse prendre qu'avec l'enregistrement de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf mostra immagini degli elementi della barra dei menu, che macOS lascia acquisire solo con la registrazione schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf にはメニューバー項目の画像が表示されます。macOS では、この画像は画面収録の権限がある App しか取得できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf에는 메뉴 막대 항목의 그림이 표시되며, macOS는 화면 기록 권한이 있는 앱만 이 그림을 가져오도록 허용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De holzBar Shelf toont afbeeldingen van je menubalkonderdelen, die macOS een app alleen laat maken met Schermopname."
