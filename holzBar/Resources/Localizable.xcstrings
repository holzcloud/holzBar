          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли щось відбувається, holzBar змінює смугу меню за вас. Якщо правил немає, він ні за чим не стежить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
