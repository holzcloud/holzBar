            "value" : "在菜单栏中拖移"
          }
        }
      }
    },
    "Drag to arrange your menu bar items into different sections." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením uspořádejte položky řádku nabídek do různých sekcí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe deine Menüleistenelemente in die gewünschten Bereiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para organizar los elementos de tu barra de menús en distintas secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments de la barre des menus dans les sections voulues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina gli elementi della barra dei menu nelle sezioni che preferisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして、メニューバーの項目を別々のセクションに整理します。"
