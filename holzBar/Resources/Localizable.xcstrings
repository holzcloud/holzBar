        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー上のクリック、スクロール、ポインタの移動を検知して、クリック・スクロール・ホバーでの表示に使います。"
          }
        },
        "ko" : {
