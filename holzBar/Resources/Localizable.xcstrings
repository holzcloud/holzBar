    "Items can also be arranged by ⌘ Command + dragging them in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente lassen sich auch mit ⌘ Befehlstaste + Ziehen direkt in der Menüleiste anordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos también se pueden ordenar arrastrándolos en la barra de menús con ⌘ Comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi disposer les éléments en les faisant glisser avec ⌘ Commande dans la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche sistemare gli elementi trascinandoli con ⌘ Comando nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Command を押しながらメニューバー内でドラッグして、項目を並べ替えることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Command 키를 누른 채 메뉴 막대에서 항목을 드래그하여 정리할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens também podem ser organizados arrastando-os na barra de menus com ⌘ Command."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti pos era ordinar ils elements cun ⌘ Command + tirar en la trav da menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы также можно расставлять, перетаскивая их в строке меню с удержанием ⌘ Command."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以按住 ⌘ Command 在菜单栏中拖移项目来整理它们。"
          }
        }
      }
    },
