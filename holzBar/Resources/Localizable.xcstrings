    "%@ is not running. Click to open it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neběží. Kliknutím ji otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft nicht. Ein Klick öffnet die App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se está ejecutando. Haz clic para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas ouvert. Un clic l'ouvre."
