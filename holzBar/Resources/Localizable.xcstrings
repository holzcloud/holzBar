    },
    "macOS prohibits “%@” from being moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS verhindert, dass «%@» verschoben wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS prohíbe mover “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
