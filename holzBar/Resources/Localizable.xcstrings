    "The holzBar Shelf shows the always-hidden items behind one tile. Click the tile to open them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf zobrazuje vždy skryté položky za jednou dlaždicí. Kliknutím na dlaždici je otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
