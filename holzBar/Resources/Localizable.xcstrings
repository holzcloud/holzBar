          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir tıklama AirDrop’u açar. Paylaşmak için dosyaları simgenin üzerine sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацання відкриває AirDrop. Перетягніть файли на значок, щоб поділитися ними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
