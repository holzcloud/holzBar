          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 nie pozwala aplikacjom ukryć tego elementu systemowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS 27 não permite que apps ocultem este item do sistema."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
