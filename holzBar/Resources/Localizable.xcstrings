        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden jóváhagyás eltávolításra kerül. Az új mappa minden szkriptjéhez újra jóváhagyás kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua persetujuan dihapus. Setiap skrip di folder baru memerlukan persetujuan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni approvazione viene rimossa. Ogni script nella nuova cartella richiede di nuovo la tua approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての承認が取り消されます。新しいフォルダ内の各スクリプトは、もう一度承認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 승인이 제거됩니다. 새 폴더의 각 스크립트는 다시 승인해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke goedkeuring wordt verwijderd. Elk script in de nieuwe map heeft opnieuw jouw goedkeuring nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde zatwierdzenie zostanie usunięte. Każdy skrypt w nowym folderze wymaga ponownego zatwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as aprovações são removidas. Cada script da nova pasta precisa da sua aprovação novamente."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tut las lubientschas vegnan allontanadas. Mintga scrip en il nov ordinatur dovra puspè tia lubientscha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все одобрения будут сброшены. Каждый скрипт в новой папке потребуется одобрить заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla godkännanden tas bort. Varje skript i den nya mappen behöver ett nytt godkännande."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm onaylar kaldırılır. Yeni klasördeki her komut dosyası için yeniden onay gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі схвалення буде скинуто. Кожен скрипт у новій папці доведеться схвалити заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有批准都会被移除。新文件夹中的每个脚本都需要你重新批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有核准都會被移除。新檔案夾中的每個指令碼都需要重新核准。"
          }
        }
      }
    },
