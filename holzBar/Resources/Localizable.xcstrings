            "value" : "%2$@のときだけ「%1$@」を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@일 때만 “%1$@” 표시."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibir “%@” somente quando %@."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mussar «%@» mo cura che %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать «%@» только когда %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当%2$@时显示“%1$@”。"
          }
        }
      }
    },
