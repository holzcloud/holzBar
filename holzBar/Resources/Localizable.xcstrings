    },
    "The color of the group's icon and name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe von Symbol und Name der Gruppe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La couleur de l'icône et du nom du groupe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore dell'icona e del nome del gruppo"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La colur dal simbol e dal num da la gruppa"
          }
        }
      }
    },
    "The file lists the applications below and the section of each. It holds no display, Wi-Fi, hotkey or other setting. Uncheck an application to leave it out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei enthält die unten aufgeführten Apps und deren Bereich. Sie enthält keine Bildschirm-, WLAN-, Tastenkürzel- oder andere Einstellungen. Entferne das Häkchen bei einer App, um sie wegzulassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient les apps ci-dessous et la section de chacune. Il ne contient aucun réglage d’écran, de Wi-Fi, de raccourci ou autre. Décochez une app pour l’exclure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file contiene le app qui sotto e la sezione di ciascuna. Non contiene impostazioni di schermo, Wi-Fi, abbreviazioni da tastiera o altro. Deseleziona un’app per escluderla."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La datoteca cuntegna las apps sutvart e la secziun da mintgina. Ella na cuntegna naginas preferenzas da visur, WLAN, cumbinaziuns da tastas u autras. Deactivescha ina app per l’exclude."
          }
        }
      }
    },
    "The holzBar Shelf is centered below the holzBar icon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
