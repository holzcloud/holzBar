          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu değişmeden kalır. ⌘Z ile geri alabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смуга меню залишиться як є. Це можна відмінити клавішами ⌘Z."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
