          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okunamadı veya bir profilin içeremeyeceği bir şey içeriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати файл, або в ньому є те, чого не може бути в профілі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
