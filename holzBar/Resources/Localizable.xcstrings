          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens podem ser ordenados arrastando-os dentro de uma seção."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils elements pon vegnir sortads cun als trair entaifer ina secziun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы можно сортировать, перетаскивая их внутри раздела."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
