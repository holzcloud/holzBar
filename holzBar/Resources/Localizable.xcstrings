        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目を holzBar のアイコンにドロップすると、その App が非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 holzBar 아이콘에 드롭하면 해당 앱이 숨겨집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
