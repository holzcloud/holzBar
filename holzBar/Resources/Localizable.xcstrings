    "Bind a profile to a display or a Space to apply it when you connect the display or switch to the Space." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svažte profil s displejem nebo plochou (Space), aby se použil, když displej připojíte nebo na plochu přepnete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe ein Profil mit einem Bildschirm oder einem Space, damit es angewendet wird, wenn du den Bildschirm anschliesst oder zum Space wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula un perfil a una pantalla o a un Space para aplicarlo al conectar la pantalla o cambiar a ese Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez un profil à un écran ou à un Space pour l'appliquer quand vous branchez l'écran ou passez à ce Space."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kösse a profilt egy kijelzőhöz vagy egy Spacehez, hogy a kijelző csatlakoztatásakor vagy a Spacere váltáskor érvénybe lépjen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikat profil ke layar atau Space agar diterapkan saat layar terhubung atau saat Anda beralih ke Space."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associa un profilo a un monitor o a uno Space per applicarlo quando colleghi il monitor o passi a quello Space."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをディスプレイまたはスペースに関連付けると、そのディスプレイを接続したときやスペースに切り替えたときに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일을 디스플레이나 스페이스에 연결하면 해당 디스플레이를 연결하거나 그 스페이스로 전환할 때 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel een profiel aan een beeldscherm of een Space om het toe te passen wanneer je het beeldscherm aansluit of naar de Space wisselt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiąż profil z wyświetlaczem lub pulpitem (Space), aby zastosować go po podłączeniu wyświetlacza lub przełączeniu na pulpit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincule um perfil a um monitor ou a um Space para aplicá-lo ao conectar o monitor ou mudar para esse Space."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associescha in profil cun in monitur u in Space per l'applitgar, cura che ti colliaschas il monitur u midas al Space."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привяжите профиль к дисплею или рабочему столу, и он будет применяться при подключении дисплея или переключении на этот рабочий стол."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppla profilen till en skärm eller ett Space så att den tillämpas när skärmen ansluts eller när du byter till Space."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ekran bağlandığında veya Space’e geçtiğinizde uygulanması için profili bir ekrana veya Space’e bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привʼяжіть профіль до дисплея або простору, і він застосовуватиметься, коли ви підключите дисплей або перемкнетеся на цей простір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将配置文件绑定到显示器或空间，即可在连接该显示器或切换到该空间时应用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將設定檔綁定到顯示器或空間，即可在連接該顯示器或切換到該空間時套用。"
          }
        }
      }
    },
