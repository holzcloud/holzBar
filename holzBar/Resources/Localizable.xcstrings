    "Exports layout, hotkeys and appearance to a file that can be imported on another Mac." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportuje uspořádání, klávesové zkratky a vzhled do souboru, který lze importovat na jiném Macu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiert Layout, Tastenkürzel und Erscheinungsbild in eine Datei, die sich auf einem anderen Mac importieren lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta la disposición, los atajos de teclado y la apariencia a un archivo que se puede importar en otro Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte la disposition, les raccourcis clavier et l'apparence dans un fichier à importer sur un autre Mac."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elrendezést, a billentyűparancsokat és a megjelenést egy fájlba exportálja, amely egy másik Macen importálható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekspor tata letak, pintasan keyboard, dan tampilan Anda ke file yang dapat diimpor di Mac lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta layout, abbreviazioni da tastiera e aspetto in un file da importare su un altro Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウト、ショートカットキー、外観をファイルに書き出し、別の Mac に読み込めるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이아웃, 단축키, 모양을 다른 Mac에서 가져올 수 있는 파일로 내보냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteert indeling, sneltoetsen en weergave naar een bestand dat op een andere Mac kan worden geïmporteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuje układ, skróty klawiszowe i wygląd do pliku, który można zaimportować na innym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta o layout, os atalhos de teclado e a aparência para um arquivo que pode ser importado em outro Mac."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta la disposiziun, las cumbinaziuns da tastas e l'apparientscha en ina datoteca che sa lascha importar sin in auter Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортирует раскладку, горячие клавиши и оформление в файл, который можно импортировать на другом Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporterar din layout, dina kortkommandon och ditt utseende till en fil som du kan importera på en annan Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzeninizi, klavye kısayollarınızı ve görünümünüzü başka bir Mac’te içe aktarabileceğiniz bir dosyaya aktarır."
          }
        },
        "uk" : {
          "stringUnit" : {
