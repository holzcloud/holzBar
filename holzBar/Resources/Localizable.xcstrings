          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holzBar Shelf a mindig rejtett elemeket egyetlen csempe mögött mutatja. Kattintson a csempére a megnyitásukhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf menampilkan item yang selalu tersembunyi di balik satu kotak. Klik kotak itu untuk membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il holzBar Shelf mostra gli elementi sempre nascosti dietro un solo riquadro. Un clic sul riquadro li apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf では、常に非表示の項目が 1 つのタイルにまとめて表示されます。タイルをクリックすると開きます。"
