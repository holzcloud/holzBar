    "The holzBar Shelf shows the always-hidden items behind one tile. Click the tile to open them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf zobrazuje vždy skryté položky za jednou dlaždicí. Kliknutím na dlaždici je otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das holzBar Shelf zeigt die immer ausgeblendeten Elemente hinter einer Kachel. Ein Klick auf die Kachel öffnet sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El holzBar Shelf muestra los elementos siempre ocultos tras una sola ficha. Haz clic en la ficha para abrirlos."
          }
