            "value" : "Affiche vos prochains événements et leurs liens de réunion dans le hub de l’encoche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra i tuoi prossimi eventi e i relativi link delle riunioni nell’hub del notch."
          }
        },
        "rm" : {
          "stringUnit" : {
