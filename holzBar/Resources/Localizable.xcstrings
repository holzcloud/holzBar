    "A capsule shows while another app uses the camera or the microphone. holzBar reads no audio or video." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsle se zobrazí, když jiná aplikace používá kameru nebo mikrofon. holzBar nečte žádný zvuk ani video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kapsel erscheint, solange eine andere App die Kamera oder das Mikrofon verwendet. holzBar liest weder Ton noch Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece una cápsula mientras otra app usa la cámara o el micrófono. holzBar no lee ni audio ni vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une capsule s'affiche tant qu'une autre app utilise la caméra ou le micro. holzBar ne lit ni audio ni vidéo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kapszula jelenik meg, amíg egy másik alkalmazás a kamerát vagy a mikrofont használja. A holzBar nem olvas hangot vagy videót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsul muncul saat app lain memakai kamera atau mikrofon. holzBar tidak membaca audio atau video apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare una capsula finché un'altra app usa la fotocamera o il microfono. holzBar non legge né audio né video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppがカメラまたはマイクを使用している間、カプセルが表示されます。holzBarは音声も映像も読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 카메라나 마이크를 사용하는 동안 캡슐이 표시됩니다. holzBar는 오디오나 비디오를 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een capsule verschijnt terwijl een andere app de camera of de microfoon gebruikt. holzBar leest geen audio of video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsuła pojawia się, gdy inna aplikacja używa kamery lub mikrofonu. holzBar nie odczytuje dźwięku ani obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cápsula aparece enquanto outro app usa a câmera ou o microfone. O holzBar não lê áudio nem vídeo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ina capsla vegn mussada uschè ditg che in'autra app duvra la camera u il microfon. holzBar na legia ni audio ni video."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока другое приложение использует камеру или микрофон, показывается капсула. holzBar не считывает ни звук, ни видео."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kapsel visas medan en annan app använder kameran eller mikrofonen. holzBar läser inget ljud eller någon video."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama kamerayı veya mikrofonu kullanırken bir kapsül görünür. holzBar hiçbir ses veya video okumaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Капсула показується, поки інша програма використовує камеру чи мікрофон. holzBar не зчитує ні звук, ні відео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当其他 App 使用摄像头或麦克风时，会显示一个胶囊。holzBar 不会读取音频或视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 使用相機或麥克風時會顯示膠囊。holzBar 不讀取任何音訊或影片。"
          }
        }
      }
    },
    "Asks for access to your Downloads folder when you switch it on. holzBar never reads what you download." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zapnutí požádá o přístup ke složce Stažené. holzBar nikdy nečte, co stahujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt beim Einschalten nach Zugriff auf deinen Downloads-Ordner. holzBar liest nie, was du lädst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide acceso a tu carpeta Descargas al activarlo. holzBar nunca lee lo que descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande l'accès à ton dossier Téléchargements lorsque tu l'actives. holzBar ne lit jamais ce que tu télécharges."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsoláskor hozzáférést kér a Letöltések mappához. A holzBar soha nem olvassa, amit letölt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meminta akses ke folder Unduhan saat diaktifkan. holzBar tidak pernah membaca apa yang Anda unduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede l'accesso alla cartella Download quando lo attivi. holzBar non legge mai ciò che scarichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、ダウンロードフォルダへのアクセスを求めます。holzBarはダウンロードした内容を読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 다운로드 폴더에 대한 접근을 요청합니다. holzBar는 다운로드한 내용을 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt om toegang tot je map Downloads wanneer je het inschakelt. holzBar leest nooit wat je downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi o dostęp do folderu Pobrane po włączeniu. holzBar nigdy nie odczytuje tego, co pobierasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede acesso à sua pasta Downloads ao ser ativado. O holzBar nunca lê o que você baixa."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dumonda l'access a tia mappa da telechargiadas cur ch'ins l'activescha. holzBar na legia mai tge che ti telechargias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении запрашивает доступ к папке «Загрузки». holzBar никогда не читает то, что вы загружаете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ber om åtkomst till mappen Hämtade filer när den slås på. holzBar läser aldrig det du hämtar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıldığında İndirilenler klasörüne erişim ister. holzBar indirdiklerinizi asla okumaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час вмикання запитує доступ до папки «Завантаження». holzBar ніколи не читає те, що ви завантажуєте."
          }
        },
