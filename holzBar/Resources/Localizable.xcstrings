    "%@ is not running. Click to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft nicht. Ein Klick öffnet die App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se está ejecutando. Haz clic para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est pas ouvert. Un clic l'ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è in esecuzione. Un clic la apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は実行されていません。クリックして開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 실행 중이 아닙니다. 클릭하여 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está em execução. Clique para abri-lo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ na curra betg. Ina clicada avra l'applicaziun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не запущено. Нажмите, чтобы открыть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未运行。点按即可打开。"
          }
        }
      }
    },
