        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzással rendezze a menüsor elemeit különböző szakaszokba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk menata item bar menu ke bagian yang berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina gli elementi della barra dei menu nelle sezioni che preferisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして、メニューバーの項目を別々のセクションに整理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 메뉴 막대 항목을 여러 섹션으로 정리하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om je menubalkonderdelen in verschillende secties te ordenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągaj, aby ułożyć elementy paska menu w różnych sekcjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para organizar os itens da sua barra de menus em seções diferentes."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira ils elements da la trav da menu en las secziuns giavischadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте элементы строки меню, чтобы разложить их по разным разделам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ordna menyradsobjekt i olika sektioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu öğelerini farklı bölümlere sıralamak için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте елементи смуги меню, щоб розкласти їх за різними розділами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以将菜单栏项目整理到不同分区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以將選單列項目排列到不同的區段。"
          }
        }
      }
    },
    "Draws rounded corners on every display, like the corners of a MacBook display." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí zaoblené rohy na každém displeji, jako jsou rohy displeje MacBooku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet auf jedem Bildschirm abgerundete Ecken wie beim Bildschirm eines MacBook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja esquinas redondeadas en todas las pantallas, como las esquinas de la pantalla de un MacBook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrondit les coins de chaque écran, comme ceux d'un écran de MacBook."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekerekített sarkokat rajzol minden kijelzőn, mint egy MacBook kijelzőjének sarkai."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggambar sudut membulat di setiap layar, seperti sudut layar MacBook."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrotonda gli angoli di ogni monitor, come quelli dello schermo di un MacBook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイに、MacBook のディスプレイの角のような丸い角を描きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이에 MacBook 디스플레이의 모서리처럼 둥근 모서리를 그립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent afgeronde hoeken op elk beeldscherm, zoals de hoeken van een MacBook-scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje zaokrąglone rogi na każdym wyświetlaczu, jak rogi wyświetlacza MacBooka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha cantos arredondados em todos os monitores, como os cantos da tela de um MacBook."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissegna cantuns radunds sin mintga monitur, sco ils cantuns d'in monitur da MacBook."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует скруглённые углы на каждом дисплее, как у экрана MacBook."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritar rundade hörn på varje skärm, som hörnen på en MacBook-skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ekranda, bir MacBook ekranının köşeleri gibi yuvarlak köşeler çizer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малює заокруглені кути на кожному дисплеї, як в екрана MacBook."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有显示器上绘制圆角，就像 MacBook 显示屏的圆角一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每個顯示器上繪製圓角，就像 MacBook 顯示器的圓角一樣。"
          }
        }
      }
    },
    "Draws the menu bar solid black, so the notch blends into it. Works best in dark mode, where the menu bar text is light." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí řádek nabídek jednolitě černě, takže výřez splyne s řádkem. Nejlépe funguje v tmavém režimu, kde je text řádku nabídek světlý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet die Menüleiste ganz schwarz, sodass die Notch darin verschwindet. Am besten im dunklen Modus, in dem der Text der Menüleiste hell ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja la barra de menús en negro sólido para que el notch se funda con ella. Funciona mejor en modo oscuro, donde el texto de la barra de menús es claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine la barre des menus en noir uni pour que l'encoche s'y fonde. Idéal en mode sombre, où le texte de la barre est clair."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tömör feketére rajzolja a menüsort, így a notch beleolvad. Sötét módban működik a legjobban, ahol a menüsor szövege világos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggambar bar menu hitam solid sehingga notch menyatu. Paling cocok di mode gelap, ketika teks bar menu terang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna la barra dei menu in nero pieno, così il notch si confonde con essa. Ideale con la modalità scura, in cui il testo della barra è chiaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーを真っ黒にして、ノッチがなじむようにします。メニューバーの文字が明るいダークモードで最もよく機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대를 완전한 검은색으로 그려 노치가 자연스럽게 어우러지게 합니다. 메뉴 막대 글자가 밝은 다크 모드에서 가장 잘 어울립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent de menubalk effen zwart, zodat de notch erin opgaat. Werkt het best in de donkere modus, waar de tekst van de menubalk licht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje pasek menu w jednolitej czerni, aby notch się z nim zlewał. Najlepiej działa w trybie ciemnym, gdzie tekst paska menu jest jasny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha a barra de menus em preto sólido para que o notch se misture a ela. Funciona melhor no modo escuro, em que o texto da barra de menus é claro."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissegna la trav da menu tut naira, uschia che la notch svanescha en ella. Il meglier en il modus stgir, nua ch'il text da la trav è cler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует строку меню сплошным чёрным цветом, чтобы вырез сливался с ней. Лучше всего работает в тёмной теме, где текст строки меню светлый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritar menyraden i helt svart så att notchen smälter in. Fungerar bäst i mörkt läge, där menyradens text är ljus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğunu düz siyah çizer, böylece notch kaybolur. Menü çubuğu metninin açık olduğu koyu modda en iyi sonucu verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Малює смугу меню суцільним чорним кольором, щоб виріз зливався з нею. Найкраще працює в темному режимі, де текст смуги меню світлий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将菜单栏绘制为纯黑色，使刘海与其融为一体。在菜单栏文字为浅色的深色模式下效果最佳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將選單列繪製為純黑色，讓瀏海與它融為一體。在深色模式下效果最佳，因為此時選單列文字為淺色。"
          }
        }
      }
    },
