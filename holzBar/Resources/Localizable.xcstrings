    "Uses no permission: holzBar notices a mirrored display and macOS's screen sharing agent." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepotřebuje žádné oprávnění: holzBar pozná zrcadlený displej a agenta sdílení obrazovky macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht keine Berechtigung: holzBar erkennt einen gespiegelten Bildschirm und den Bildschirmfreigabe-Agenten von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usa ningún permiso: holzBar detecta una pantalla duplicada y el agente de compartir pantalla de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune autorisation requise : holzBar détecte un écran recopié et l'agent de partage d'écran de macOS."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem használ engedélyt: a holzBar észleli a tükrözött kijelzőt és a macOS képernyőmegosztó ügynökét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak memakai izin: holzBar mendeteksi layar yang dicerminkan dan agen berbagi layar macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve alcuna autorizzazione: holzBar rileva un monitor duplicato e l'agente di condivisione schermo di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限は使いません。holzBar は、ミラーリングされたディスプレイと macOS の画面共有エージェントを検知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한을 사용하지 않습니다. holzBar는 미러링된 디스플레이와 macOS의 화면 공유 에이전트를 감지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt geen toestemming: holzBar merkt een gespiegeld beeldscherm en de schermdelingsagent van macOS op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie używa żadnego uprawnienia: holzBar zauważa powielony wyświetlacz i agenta udostępniania ekranu macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não usa nenhuma permissão: o holzBar percebe um monitor espelhado e o agente de compartilhamento de tela do macOS."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dovra nagina permissiun: holzBar percorscha in monitur spievlà e l'agent da partiziun dal monitur da macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения не требуются: holzBar замечает дублированный дисплей и агент демонстрации экрана macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder ingen behörighet: holzBar känner av en speglad skärm och macOS skärmdelningsagent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir izin kullanmaz: holzBar yansıtılan bir ekranı ve macOS ekran paylaşım aracısını algılar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволів не потрібно: holzBar помічає дзеркальний дисплей і агент демонстрації екрана macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不使用任何权限：holzBar 会察觉镜像显示器以及 macOS 的屏幕共享代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要任何權限：holzBar 會偵測鏡像顯示器與 macOS 的螢幕分享代理程式。"
          }
        }
      }
    },
