        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以将菜单栏项目整理到不同分区。"
          }
        }
      }
    },
    "Draws rounded corners on every display, like the corners of a MacBook display." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí zaoblené rohy na každém displeji, jako jsou rohy displeje MacBooku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet auf jedem Bildschirm abgerundete Ecken wie beim Bildschirm eines MacBook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja esquinas redondeadas en todas las pantallas, como las esquinas de la pantalla de un MacBook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrondit les coins de chaque écran, comme ceux d'un écran de MacBook."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrotonda gli angoli di ogni monitor, come quelli dello schermo di un MacBook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイに、MacBook のディスプレイの角のような丸い角を描きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이에 MacBook 디스플레이의 모서리처럼 둥근 모서리를 그립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent afgeronde hoeken op elk beeldscherm, zoals de hoeken van een MacBook-scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje zaokrąglone rogi na każdym wyświetlaczu, jak rogi wyświetlacza MacBooka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha cantos arredondados em todos os monitores, como os cantos da tela de um MacBook."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissegna cantuns radunds sin mintga monitur, sco ils cantuns d'in monitur da MacBook."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует скруглённые углы на каждом дисплее, как у экрана MacBook."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有显示器上绘制圆角，就像 MacBook 显示屏的圆角一样。"
          }
        }
      }
    },
    "Draws the menu bar solid black, so the notch blends into it. Works best in dark mode, where the menu bar text is light." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí řádek nabídek jednolitě černě, takže výřez splyne s řádkem. Nejlépe funguje v tmavém režimu, kde je text řádku nabídek světlý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet die Menüleiste ganz schwarz, sodass die Notch darin verschwindet. Am besten im dunklen Modus, in dem der Text der Menüleiste hell ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja la barra de menús en negro sólido para que el notch se funda con ella. Funciona mejor en modo oscuro, donde el texto de la barra de menús es claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine la barre des menus en noir uni pour que l'encoche s'y fonde. Idéal en mode sombre, où le texte de la barre est clair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna la barra dei menu in nero pieno, così il notch si confonde con essa. Ideale con la modalità scura, in cui il testo della barra è chiaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーを真っ黒にして、ノッチがなじむようにします。メニューバーの文字が明るいダークモードで最もよく機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대를 완전한 검은색으로 그려 노치가 자연스럽게 어우러지게 합니다. 메뉴 막대 글자가 밝은 다크 모드에서 가장 잘 어울립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent de menubalk effen zwart, zodat de notch erin opgaat. Werkt het best in de donkere modus, waar de tekst van de menubalk licht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje pasek menu w jednolitej czerni, aby notch się z nim zlewał. Najlepiej działa w trybie ciemnym, gdzie tekst paska menu jest jasny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha a barra de menus em preto sólido para que o notch se misture a ela. Funciona melhor no modo escuro, em que o texto da barra de menus é claro."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dissegna la trav da menu tut naira, uschia che la notch svanescha en ella. Il meglier en il modus stgir, nua ch'il text da la trav è cler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует строку меню сплошным чёрным цветом, чтобы вырез сливался с ней. Лучше всего работает в тёмной теме, где текст строки меню светлый."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将菜单栏绘制为纯黑色，使刘海与其融为一体。在菜单栏文字为浅色的深色模式下效果最佳。"
          }
        }
      }
    },
    "Drop an item on the holzBar icon to hide its app." : {
