    "To apply a layout profile with a Focus, add the holzBar filter to that Focus in System Settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li použít profil uspořádání se Soustředěním, přidejte filtr holzBar k tomuto Soustředění v Nastavení systému."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mit einem Fokus ein Layoutprofil anzuwenden, füge den holzBar-Filter in den Systemeinstellungen zu diesem Fokus hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicar un perfil de disposición con un modo de concentración, añade el filtro de holzBar a ese modo en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour appliquer un profil de disposition avec un mode de concentration, ajoutez le filtre holzBar à ce mode dans Réglages Système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per applicare un profilo di layout con un Focus, aggiungi il filtro holzBar a quel Focus in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスでレイアウトプロファイルを適用するには、システム設定でそのフォーカスに holzBar のフィルタを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 모드로 레이아웃 프로파일을 적용하려면 시스템 설정에서 해당 집중 모드에 holzBar 필터를 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een indelingsprofiel met een Focus toe te passen, voeg je het holzBar-filter toe aan die Focus in Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zastosować profil układu z trybem skupienia, dodaj filtr holzBar do tego trybu w Ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicar um perfil de layout com um Foco, adicione o filtro do holzBar a esse Foco em Ajustes do Sistema."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per applitgar in profil da layout cun in focus, agiuntescha il filter holzBar a quest focus en las preferenzas dal sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы применять профиль раскладки через режим фокусирования, добавьте фильтр holzBar к этому режиму в «Системных настройках»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要通过专注模式应用布局配置文件，请在“系统设置”中将 holzBar 过滤器添加到该专注模式。"
          }
        }
      }
    },
