          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het paneel Menubalkindeling toont afbeeldingen van je menubalkonderdelen, die macOS een app alleen laat maken met Schermopname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel Układ paska menu pokazuje obrazy elementów paska menu, które macOS pozwala aplikacji robić tylko z uprawnieniem Nagrywanie ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel Layout da Barra de Menus mostra imagens dos seus itens da barra de menus, que o macOS só permite a um app capturar com Gravação de Tela."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il champ «Disposiziun da la trav da menu» mussa maletgs da tes elements, ils quals macOS lascha far mo cun la Bildschirmaufnahme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На панели «Раскладка строки меню» показаны изображения элементов вашей строки меню, а macOS позволяет приложению получать их только при наличии доступа к записи экрана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyradslayout visar bilder av menyradsobjekt, som macOS bara låter en app ta med Skärminspelning."
          }
