    "A click opens AirDrop. Drop files on the icon to share them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick öffnet AirDrop. Lege Dateien auf dem Symbol ab, um sie zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic abre AirDrop. Suelta archivos sobre el icono para compartirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic ouvre AirDrop. Déposez des fichiers sur l’icône pour les partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic apre AirDrop. Trascina i file sull’icona per condividerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックすると AirDrop が開きます。ファイルをアイコンにドロップして共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 AirDrop이 열립니다. 아이콘에 파일을 드롭하여 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um clique abre o AirDrop. Solte arquivos sobre o ícone para compartilhá-los."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In clic avra AirDrop. Tschenta datotecas sin l’icona per las parter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие открывает AirDrop. Перетащите файлы на значок, чтобы поделиться ими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按即可打开“隔空投送”。将文件拖到图标上即可共享。"
          }
        }
      }
    },
    "A click opens fast user switching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick öffnet den schnellen Benutzerwechsel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic abre el cambio rápido de usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic ouvre le changement rapide d’utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic apre il cambio rapido utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックすると高速ユーザ切り替えが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 빠른 사용자 전환이 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um clique abre a troca rápida de usuário."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In clic avra la midada svelta da utilisader."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие открывает быстрое переключение пользователей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按即可打开“快速切换用户”。"
          }
        }
      }
    },
    "A click opens Focus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick öffnet Fokus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic abre Concentración."
          }
        },
        "fr" : {
