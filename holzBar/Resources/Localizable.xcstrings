    "%@\nShown only while the rule “%@” holds" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNur sichtbar, solange die Regel «%@» gilt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisible solo mientras se cumpla la regla “%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisible seulement tant que la règle « %@ » est vraie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisibile solo finché la regola «%@» è vera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nルール「%@」が成立している間だけ表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n“%@” 규칙이 참인 동안에만 표시됨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nExibido somente enquanto a regra “%@” for válida"
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisibel mo uschè ditg che la regla «%@» vala"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nПоказывается, только пока выполняется правило «%@»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n仅在规则“%@”成立期间显示"
          }
        }
      }
    },
    "%@ is shown only while this is true." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird nur gezeigt, solange das gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se muestra solo mientras esto sea verdadero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est affiché que tant que cela est vrai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene mostrato solo finché questo è vero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、これが真の間だけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이 조건이 참인 동안에만 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é exibido somente enquanto isto for verdadeiro."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vegn mussà mo uschè ditg che quai vala."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ показывается, только пока это выполняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@仅在此条件成立期间显示。"
          }
        }
      }
    },
    "%@ is moved into a hidden section while the conditions do not hold, and back to where you had it while they do. A move by hand lasts only while they hold. Nothing happens while a condition cannot be read. A profile leaves this item where its rule puts it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird in einen versteckten Bereich verschoben, solange die Bedingungen nicht gelten, und zurück in den Bereich, in dem es vorher war, solange sie gelten. Eine Verschiebung von Hand gilt nur, solange die Bedingungen gelten. Es passiert nichts, solange sich eine Bedingung nicht lesen lässt. Ein Profil lässt dieses Element dort, wo seine Regel es hinstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se mueve a una sección oculta mientras no se cumplan las condiciones, y vuelve a donde lo tenías mientras se cumplan. Un movimiento a mano dura solo mientras se cumplen. No pasa nada mientras no se pueda leer una condición. Un perfil deja este elemento donde lo pone su regla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passe dans une section masquée tant que les conditions ne sont pas remplies, et revient là où il était tant qu’elles le sont. Un déplacement à la main ne dure que tant que les conditions sont remplies. Rien ne se passe tant qu’une condition ne peut pas être lue. Un profil laisse cet élément là où sa règle le met."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ viene spostato in una sezione nascosta finché le condizioni non sono vere, e torna dov’era finché lo sono. Uno spostamento a mano dura solo finché le condizioni sono vere. Non succede nulla finché una condizione non può essere letta. Un profilo lascia questo elemento dove lo mette la sua regola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は、条件が成立していない間は非表示セクションに移動し、成立している間は元の位置に戻ります。手動での移動が有効なのは、条件が成立している間だけです。条件を読み取れない間は、何も起こりません。プロファイルは、この項目をルールが置いた位置のままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조건이 참이 아닌 동안 %@은(는) 숨겨진 섹션으로 옮겨지고, 조건이 참인 동안에는 원래 두었던 위치로 돌아갑니다. 직접 옮긴 것은 조건이 참인 동안에만 유지됩니다. 조건을 읽을 수 없는 동안에는 아무 일도 일어나지 않습니다. 프로파일은 이 항목을 규칙이 둔 위치에 그대로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é movido para uma seção oculta enquanto as condições não forem válidas, e volta para onde você o tinha enquanto forem. Uma movimentação manual dura somente enquanto elas forem válidas. Nada acontece enquanto uma condição não puder ser lida. Um perfil deixa este item onde a regra dele o coloca."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vegn mess en ina secziun zuppada uschè ditg che las cundiziuns na valan betg, e turna là nua ch’el era uschè ditg ch’ellas valan. In move a maun vala mo uschè ditg che las cundiziuns valan. Nagut na capita uschè ditg che ina cundiziun na po betg vegnir legida. In profil lascha quest element là nua che sia regla til metta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ перемещается в скрытый раздел, пока условия не выполняются, и возвращается на прежнее место, пока выполняются. Перемещение вручную действует, только пока условия выполняются. Пока условие невозможно прочитать, ничего не происходит. Профиль оставляет этот элемент там, куда его поместило правило."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件不成立期间，%@会被移到隐藏分区；条件成立期间，它会回到你原先放置的位置。手动移动仅在条件成立期间有效。无法读取条件时，不会发生任何变化。配置文件会让此项目保持在其规则所放置的位置。"
          }
        }
      }
    },
    "%lld items are controlled by rules. A profile leaves them where their rule puts them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Elemente werden von Regeln gesteuert. Ein Profil lässt sie dort, wo ihre Regel sie hinstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementos están controlados por reglas. Un perfil los deja donde los ponen sus reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments sont pilotés par des règles. Un profil les laisse là où leur règle les met."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi sono controllati da regole. Un profilo li lascia dove li mette la loro regola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個の項目がルールで制御されています。プロファイルは、それらをルールが置いた位置のままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 %lld개가 규칙으로 제어됩니다. 프로파일은 이 항목들을 규칙이 둔 위치에 그대로 둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens são controlados por regras. Um perfil os deixa onde as regras deles os colocam."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elements vegnan controllads da reglas. In profil als lascha là nua che lur regla als metta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементов под управлением правил: %lld. Профиль оставляет их там, куда их поместили правила."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个项目由规则控制。配置文件会让它们保持在各自规则所放置的位置。"
          }
        }
      }
    },
