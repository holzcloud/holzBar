    "Hide an Apple app's items in Menu Bar Layout, and keep the ones you want one click away here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryjte položky aplikace Apple v uspořádání řádku nabídek a ty, které chcete, mějte po ruce na jedno kliknutí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blende die Elemente einer Apple-App im Menüleistenlayout aus und halte hier die gewünschten einen Klick entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta los elementos de una app de Apple en la disposición de la barra de menús y deja aquí a un clic los que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez les éléments d’une app Apple dans la disposition de la barre des menus et gardez ici ceux que vous voulez à un clic."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejtse el egy Apple-alkalmazás elemeit a Menüsor elrendezésében, a kívántakat pedig tartsa egy kattintásnyira itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembunyikan item app Apple di Tata Letak Bar Menu dan simpan yang Anda inginkan satu klik dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi gli elementi di un’app Apple nel layout della barra dei menu e tieni qui, a un clic, quelli che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の App の項目はメニューバーのレイアウトで非表示にして、使いたいものだけをここからワンクリックで開けるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 레이아웃에서 Apple 앱의 항목을 숨기고, 필요한 항목은 여기에 두어 한 번의 클릭으로 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg de onderdelen van een Apple-app in Menubalkindeling en houd de onderdelen die je wilt hebben hier één klik weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj elementy aplikacji Apple w układzie paska menu i miej te, które chcesz, pod ręką jednym kliknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte os itens de um app da Apple no Layout da Barra de Menus e mantenha aqui, a um clique, os que quiser."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuppenta ils elements d’ina app Apple en la disposiziun da la trav da menu e tegna qua a in clic quels che ti vuls."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скройте элементы приложений Apple в разделе «Раскладка строки меню» и оставьте здесь те, что нужны, — они будут доступны одним нажатием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj en Apple-apps objekt i Menyradslayout och ha de du vill ha ett klick bort här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Apple uygulamasının öğelerini Menü Çubuğu Düzeni’nde gizleyin, istediklerinizi burada bir tıklama uzakta tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховайте елементи програм Apple в розділі «Розкладка смуги меню» і залиште тут ті, що потрібні, — вони будуть доступні одним клацанням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“菜单栏布局”中隐藏 Apple App 的项目，并把需要的项目留在这里，一键即可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「選單列佈局」中隱藏 Apple App 的項目，並將想要的項目留在這裡，一鍵即可使用。"
          }
        }
      }
    },
