          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic per mostrare gli elementi nascosti. Clic destro per le impostazioni di holzBar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
