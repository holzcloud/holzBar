          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic droit dans une zone vide de la barre des menus affiche une version réduite du menu de holzBar. Désactivez ce réglage en cas de conflit avec d'autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il clic destro in un'area vuota della barra dei menu mostra una versione ridotta del menu di holzBar. Disattiva questa impostazione in caso di conflitti con altre app."
