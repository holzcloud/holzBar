    "Items can also be arranged by ⌘ Command + dragging them in the menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky lze uspořádat i přetažením v řádku nabídek s podrženým ⌘ Command."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente lassen sich auch mit ⌘ Befehlstaste + Ziehen direkt in der Menüleiste anordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos también se pueden ordenar arrastrándolos en la barra de menús con ⌘ Comando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi disposer les éléments en les faisant glisser avec ⌘ Commande dans la barre des menus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elemek a menüsorban ⌘ Command nyomva tartásával húzva is rendezhetők."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item juga dapat ditata di bar menu dengan menahan ⌘ Command dan menyeret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche sistemare gli elementi trascinandoli con ⌘ Comando nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Command を押しながらメニューバー内でドラッグして、項目を並べ替えることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘ Command 키를 누른 채 메뉴 막대에서 항목을 드래그하여 정리할 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdelen kunnen ook worden geordend door ze met ⌘ Command ingedrukt in de menubalk te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementy można też ułożyć, przeciągając je na pasku menu z wciśniętym ⌘ Command."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens também podem ser organizados arrastando-os na barra de menus com ⌘ Command."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti pos era ordinar ils elements cun ⌘ Command + tirar en la trav da menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы также можно расставлять, перетаскивая их в строке меню с удержанием ⌘ Command."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekt kan också ordnas på menyraden genom att hålla ⌘ Command nedtryckt och dra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öğeler, menü çubuğunda ⌘ Command tuşunu basılı tutarak sürüklenerek de sıralanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Елементи також можна розставляти, перетягуючи їх у смузі меню з утриманням ⌘ Command."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以按住 ⌘ Command 在菜单栏中拖移项目来整理它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以在選單列中按住 ⌘ Command 並拖移項目來排列。"
          }
        }
      }
    },
