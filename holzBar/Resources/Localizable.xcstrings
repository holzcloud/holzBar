    "Give a menu bar item its own hotkey with Set Hotkey… in its menu in the Menu Bar Layout pane." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidělte položce řádku nabídek vlastní klávesovou zkratku pomocí Nastavit klávesovou zkratku… v její nabídce v podokně Uspořádání řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einem Menüleistenelement mit «Tastenkürzel festlegen …» in seinem Menü im Bereich «Menüleistenlayout» ein eigenes Tastenkürzel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a un elemento de la barra de menús su propio atajo de teclado con Definir atajo de teclado… en su menú, en el panel Disposición de la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attribuez un raccourci à un élément avec « Définir un raccourci… » dans son menu, dans la sous-fenêtre « Disposition de la barre des menus »."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon egy menüsor-elemnek saját billentyűparancsot a Billentyűparancs beállítása… paranccsal az elem menüjében, a Menüsor elrendezése panelen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri item bar menu pintasan keyboard sendiri dengan Atur Pintasan… di menu item di Tata Letak Bar Menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna un'abbreviazione a un elemento con «Imposta abbreviazione…» nel suo menu, nel pannello «Layout della barra dei menu»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー項目専用のショートカットキーは、メニューバーレイアウトのパネルにあるその項目のメニューの「ショートカットキーを設定…」から設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 레이아웃 패널에서 메뉴 막대 항목의 메뉴에 있는 “단축키 설정…”을 사용해 해당 항목에 고유한 단축키를 지정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef een menubalkonderdeel een eigen sneltoets met Stel sneltoets in… in het menu ervan in het paneel Menubalkindeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadaj elementowi paska menu własny skrót klawiszowy przez Ustaw skrót… w jego menu w panelu Układ paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a um item da barra de menus o próprio atalho de teclado com Definir atalho de teclado… no menu dele, no painel Layout da Barra de Menus."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dà ad in element da la trav da menu ina atgna cumbinaziun da tastas cun «Definir la cumbinaziun …» en ses menu en il champ «Disposiziun da la trav da menu»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначьте элементу строки меню собственную горячую клавишу командой «Назначить горячую клавишу…» в его меню на панели «Раскладка строки меню»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge ett menyradsobjekt ett eget kortkommando med Ställ in kortkommando… i objektets meny, i Menyradslayout."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir menü çubuğu öğesine, Menü Çubuğu Düzeni’nde öğenin menüsündeki Kısayol Ayarla… ile kendi klavye kısayolunu verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призначте елементу смуги меню власну гарячу клавішу командою «Призначити гарячу клавішу…» у його меню на панелі «Розкладка смуги меню»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“菜单栏布局”面板中，通过菜单栏项目菜单里的“设置快捷键…”，可以为该项目指定专属快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「選單列佈局」面板中，使用項目選單的「設定快速鍵⋯」為選單列項目指定專屬快速鍵。"
          }
        }
      }
    },
