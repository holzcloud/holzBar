    "Off by default, because AirPods disconnect whenever they go back in their case." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím stavu vypnuto, protože se AirPods odpojí, kdykoli se vrátí do pouzdra."
          }
        },
        "de" : {
          "stringUnit" : {
