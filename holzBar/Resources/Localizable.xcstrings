    "Plays or pauses. Right-click for previous and next." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přehraje nebo pozastaví. Pravým tlačítkem přejdete na předchozí a další."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt ab oder pausiert. Rechtsklick für vorherigen und nächsten Titel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce o pausa. Clic derecho para anterior y siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit ou met en pause. Clic droit pour précédent et suivant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejátszás vagy szünet. Jobb kattintással az előző és a következő érhető el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar atau jeda. Klik kanan untuk sebelumnya dan berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce o mette in pausa. Clic destro per precedente e successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生または一時停止します。右クリックで前へ・次へ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생하거나 일시 정지합니다. 오른쪽 클릭으로 이전 및 다음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
