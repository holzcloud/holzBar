    "Click inside an empty area of the menu bar to show hidden menu bar items." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím do prázdné oblasti řádku nabídek zobrazíte skryté položky řádku nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf eine leere Stelle der Menüleiste, um ausgeblendete Menüleistenelemente einzublenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en un área vacía de la barra de menús para mostrar los elementos ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez dans une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic in un'area vuota della barra dei menu per mostrare gli elementi nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの空いている部分をクリックすると、非表示の項目が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 빈 영역을 클릭하면 숨겨진 항목이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik in een leeg gebied van de menubalk om verborgen menubalkonderdelen te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij w puste miejsce na pasku menu, aby pokazać ukryte elementy paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em uma área vazia da barra de menus para exibir os itens ocultos."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicca en ina zona vida da la trav da menu per mussar ils elements zuppads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на пустую область строки меню, чтобы показать скрытые элементы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按菜单栏的空白区域即可显示隐藏的项目。"
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access holzBar's settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím zobrazíte skryté položky řádku nabídek. Kliknutím pravým tlačítkem přejdete do nastavení holzBar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
