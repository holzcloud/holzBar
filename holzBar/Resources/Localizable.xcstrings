    "macOS 27 doesn't let apps hide this system item." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 aplikacím nedovolí tuto systémovou položku skrýt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 lässt Apps dieses Systemelement nicht ausblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 no permite que las apps oculten este elemento del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 ne permet pas aux apps de masquer cet élément système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 non consente alle app di nascondere questo elemento di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 では、App がこのシステム項目を非表示にすることはできません。"
