    "Tells you when AirPods and other accessories connect, disconnect or run low." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní vás, když se AirPods a další příslušenství připojí, odpojí nebo jim dochází energie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt dir, wenn AirPods und anderes Zubehör sich verbinden, trennen oder fast leer sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisa cuando los AirPods y otros accesorios se conectan, se desconectan o tienen poca batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous prévient quand des AirPods ou d’autres accessoires se connectent, se déconnectent ou sont presque déchargés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelzi, ha az AirPods és más tartozékok csatlakoznak, leválnak vagy lemerülőben vannak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu saat AirPods dan aksesori lain terhubung, terputus, atau baterainya hampir habis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa quando AirPods e altri accessori si connettono, si disconnettono o stanno per scaricarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods などのアクセサリが接続・切断されたときや、バッテリー残量が少なくなったときにお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods 및 기타 액세서리가 연결되거나 연결이 끊어지거나 배터리가 부족할 때 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je weten wanneer AirPods en andere accessoires verbinding maken, loskoppelen of bijna leeg zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informuje, gdy AirPods i inne akcesoria łączą się, rozłączają lub mają mało energii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa quando AirPods e outros acessórios se conectam, se desconectam ou estão com pouca bateria."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta di quand che AirPods ed auters accessoris se colleschan, se disconnectan u èn bunamain vids."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, когда AirPods и другие аксессуары подключаются, отключаются или разряжаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berättar när AirPods och andra tillbehör ansluts, kopplas från eller har lågt batteri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods ve diğer aksesuarlar bağlandığında, bağlantısı kesildiğinde veya pili azaldığında size söyler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє, коли AirPods та інші аксесуари підключаються, відключаються або розряджаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 AirPods 和其他配件连接、断开或电量不足时通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 AirPods 與其他配件連線、中斷連線或電量不足時通知你。"
          }
        }
      }
    },
