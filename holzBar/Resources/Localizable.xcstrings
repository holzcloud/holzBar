    "Uses no permission: holzBar notices a mirrored display and macOS's screen sharing agent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht keine Berechtigung: holzBar erkennt einen gespiegelten Bildschirm und den Bildschirmfreigabe-Agenten von macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune autorisation requise : holzBar détecte un écran recopié et l'agent de partage d'écran de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
