    },
    "Display the icon as a monochrome image that dynamically adjusts to match the menu bar's appearance. This setting removes all color from the icon, but ensures consistent rendering with both light and dark backgrounds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Symbol einfarbig an, passend zum Erscheinungsbild der Menüleiste. Dabei geht die Farbe des Symbols verloren, dafür wirkt es auf hellem und dunklem Hintergrund gleich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'icône en monochrome, adaptée à l'apparence de la barre des menus. L'icône perd ses couleurs, mais s'affiche de la même façon sur fond clair et sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'icona in monocromia, adattata all'aspetto della barra dei menu. L'icona perde i colori, ma appare uguale su sfondi chiari e scuri."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mussa il simbol en ina colur, adattà a l'apparientscha da la trav da menu. Il simbol perda sias colurs, ma cumpara a moda uniforma sin fund cler e stgir."
          }
        }
      }
    },
    "Displays with a notch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirme mit Notch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrans avec encoche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
