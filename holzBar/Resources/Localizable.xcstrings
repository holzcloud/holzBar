    "When something happens, holzBar changes the menu bar for you. With no rules, nothing is observed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn etwas passiert, passt holzBar die Menüleiste für dich an. Ohne Regeln wird nichts beobachtet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelque chose se produit, holzBar adapte la barre des menus pour vous. Sans règles, rien n’est observé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando succede qualcosa, holzBar adatta la barra dei menu per te. Senza regole non viene osservato nulla."
