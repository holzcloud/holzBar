        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem isso, o holzBar mostra os ícones dos apps. Você pode mudar isso a qualquer momento em Ajustes → Avançado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza mussa holzBar las icònas da las apps. Ti pos midar quai mintga mument sut Parameters → Avanzà."
