    "macOS asks for Bluetooth when the Notch hub is on." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS požádá o Bluetooth, když je zapnuté centrum u výřezu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt nach Bluetooth, sobald der Notch-Hub an ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pedirá acceso a Bluetooth en cuanto el centro del notch esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande l’accès au Bluetooth dès que le hub de l’encoche est activé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS Bluetooth-engedélyt kér, amikor a notch-központ be van kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meminta akses Bluetooth saat pusat notch diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chiede il Bluetooth non appena l’hub del notch è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチハブがオンになると、macOS が Bluetooth の使用許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 허브가 켜지면 macOS가 Bluetooth 사용 권한을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vraagt om Bluetooth wanneer de notch-hub aan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zapyta o Bluetooth, gdy centrum notcha jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pede acesso ao Bluetooth assim que o hub do notch estiver ativado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS dumonda davart Bluetooth uschespert che il hub da la notch è activà."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запросит доступ к Bluetooth, как только центр у выреза будет включён."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ber om Bluetooth-åtkomst när notchcentret är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch merkezi açıkken macOS Bluetooth erişimi ister."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запитає доступ до Bluetooth, щойно центр біля вирізу буде ввімкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海中心开启后，macOS 会请求使用蓝牙。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「瀏海中心」時，macOS 會要求藍牙權限。"
          }
        }
      }
