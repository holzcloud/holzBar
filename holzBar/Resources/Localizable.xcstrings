    "Tints the menu bar with the main colors of your wallpaper, read from its file." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabarví řádek nabídek hlavními barvami vaší tapety, přečtenými z jejího souboru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tönt die Menüleiste in den Hauptfarben deines Hintergrundbilds, gelesen aus seiner Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiñe la barra de menús con los colores principales de tu fondo de escritorio, leídos de su archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teinte la barre des menus avec les couleurs principales de votre fond d'écran, lues dans son fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora la barra dei menu con i colori principali del tuo sfondo, letti dal suo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁紙のファイルから読み取った主な色で、メニューバーに色合いを付けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경화면 파일에서 읽은 주요 색상으로 메뉴 막대에 색조를 입힙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tint de menubalk met de hoofdkleuren van je achtergrond, gelezen uit het bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabarwia pasek menu głównymi kolorami tapety, odczytanymi z jej pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica à barra de menus um tom com as cores principais do seu plano de fundo, lidas do arquivo dele."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinta la trav da menu cun las colurs principalas da tes maletg dal fund, ditgas da sia datoteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрашивает строку меню в основные цвета ваших обоев, считанные из их файла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用从壁纸文件中读取的主要颜色为菜单栏着色。"
          }
        }
      }
