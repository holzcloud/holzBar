    "%lld items will move, %lld are not in the menu bar now. The layout as it is now is kept first, so you can undo this." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld položek se přesune, %lld jich teď není v řádku nabídek. Aktuální uspořádání se nejdřív uloží, takže to můžete vrátit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte werden verschoben, %lld sind jetzt nicht in der Menüleiste. Das jetzige Layout wird zuerst gesichert, damit du das rückgängig machen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se moverán %lld elementos; %lld no están ahora en la barra de menús. Primero se conserva la disposición actual, para que puedas deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments seront déplacés, %lld ne sont pas dans la barre des menus actuellement. La disposition actuelle est d’abord conservée, afin que vous puissiez annuler."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elem áthelyezésre kerül, %lld jelenleg nincs a menüsoron. A jelenlegi elrendezés előbb mentésre kerül, így visszavonhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld item akan dipindahkan, %lld saat ini tidak ada di bar menu. Tata letak Anda saat ini disimpan dulu agar Anda dapat mengurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi verranno spostati, %lld non sono ora nella barra dei menu. Il layout attuale viene prima conservato, così puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個の項目が移動し、%lld 個は現在メニューバーにありません。現在のレイアウトは先に保存されるので、元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 %lld개가 이동하고, %lld개는 지금 메뉴 막대에 없습니다. 현재 레이아웃이 먼저 보관되므로 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld onderdelen worden verplaatst, %lld staan nu niet in de menubalk. De huidige indeling wordt eerst bewaard, zodat je dit kunt herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementów zostanie przeniesionych, %lld nie ma teraz na pasku menu. Obecny układ zostaje najpierw zachowany, więc możesz to cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens serão movidos; %lld não estão na barra de menus agora. O layout atual é mantido antes, para que você possa desfazer."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elements vegnan spustads, %lld n’èn ussa betg en la trav da menu. Il layout actual vegn l’emprim memorisà, uschè che ti pos revocar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет перемещено элементов: %lld; сейчас в строке меню нет: %lld. Текущая раскладка сохраняется заранее, так что это можно отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekt kommer att flyttas, %lld finns inte på menyraden just nu. Din nuvarande layout sparas först så att du kan ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld öğe taşınacak, %lld öğe şu anda menü çubuğunda değil. Geri alabilmeniz için geçerli düzeniniz önce kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде переміщено елементів: %lld; зараз у смузі меню немає: %lld. Поточна розкладка зберігається заздалегідь, тож це можна відмінити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移动 %lld 个项目，另有 %lld 个当前不在菜单栏中。会先保留当前布局，因此你可以撤销此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移動 %lld 個項目，另有 %lld 個目前不在選單列中。系統會先保留目前的佈局，因此你可以還原此操作。"
          }
        }
      }
    },
