    "The holzBar Shelf hangs directly below the menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Shelf visí přímo pod řádkem nabídek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das holzBar Shelf hängt direkt unter der Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El holzBar Shelf cuelga justo debajo de la barra de menús."
          }
