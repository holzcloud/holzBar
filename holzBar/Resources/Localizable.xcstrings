    "Without it holzBar shows the apps' icons. You can change this any time in Settings → Advanced." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez toho holzBar zobrazuje ikony aplikací. Můžete to kdykoli změnit v Nastavení → Pokročilé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne sie zeigt holzBar die Symbole der Apps. Du kannst das jederzeit unter Einstellungen → Erweitert ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin ello, holzBar muestra los iconos de las apps. Puedes cambiarlo en cualquier momento en Ajustes → Avanzado."
