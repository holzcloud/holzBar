    "When something happens, holzBar changes the menu bar for you. With no rules, nothing is observed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se něco stane, holzBar změní řádek nabídek za vás. Bez pravidel se nic nesleduje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn etwas passiert, passt holzBar die Menüleiste für dich an. Ohne Regeln wird nichts beobachtet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando ocurre algo, holzBar cambia la barra de menús por ti. Sin reglas, no se observa nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand quelque chose se produit, holzBar adapte la barre des menus pour vous. Sans règles, rien n’est observé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando succede qualcosa, holzBar adatta la barra dei menu per te. Senza regole non viene osservato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かが起きたときに、holzBar が代わりにメニューバーを変更します。ルールがない場合は、何も監視されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 일이 생기면 holzBar가 대신 메뉴 막대를 바꿉니다. 규칙이 없으면 아무것도 관찰하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer er iets gebeurt, past holzBar de menubalk voor je aan. Zonder regels wordt niets in de gaten gehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy coś się dzieje, holzBar zmienia pasek menu za Ciebie. Bez reguł nic nie jest obserwowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando algo acontece, o holzBar altera a barra de menus por você. Sem regras, nada é observado."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cura che alchen capita, adatta holzBar la trav da menu per tai. Senza reglas na vegn observà nagut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда что-то происходит, holzBar меняет строку меню за вас. Если правил нет, ни за чем не наблюдает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生某些事情时，holzBar 会替你更改菜单栏。没有规则时，不会观察任何内容。"
          }
        }
      }
    },
