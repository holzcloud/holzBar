    "Applications with a hidden item that are closed appear dimmed in the holzBar Shelf. Click one to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschlossene Apps mit einem ausgeblendeten Element erscheinen abgeblendet im holzBar Shelf. Ein Klick öffnet die App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las aplicaciones con un elemento oculto que están cerradas aparecen atenuadas en el holzBar Shelf. Haz clic en una para abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les applications fermées qui ont un élément masqué apparaissent estompées dans le holzBar Shelf. Un clic ouvre l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app chiuse con un elemento nascosto appaiono attenuate nel holzBar Shelf. Un clic apre l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示の項目があり、起動していない App は、holzBar Shelf に薄く表示されます。クリックすると開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨진 항목이 있는 앱이 종료되어 있으면 holzBar Shelf에 흐리게 표시됩니다. 클릭하면 해당 앱이 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aplicativos com um item oculto que estão fechados aparecem esmaecidos no holzBar Shelf. Clique em um para abri-lo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las applicaziuns serradas cun in element zuppà cumparan sfumadas en il holzBar Shelf. Ina clicada avra l'applicaziun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытые приложения со скрытым элементом отображаются в holzBar Shelf затемнёнными. Нажмите на одно из них, чтобы открыть его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
