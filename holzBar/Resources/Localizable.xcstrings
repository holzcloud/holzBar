    "Stash files you drag to the notch and drop them somewhere else later." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovejte soubory přetažené k výřezu a později je pusťte jinam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Dateien an der Notch ab und ziehe sie später woanders hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja archivos en el notch y arrástralos a otro sitio más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des fichiers à l'encoche et déplacez-les ailleurs plus tard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tárolja a notchra húzott fájlokat, és engedje el őket később máshol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan file yang Anda seret ke notch agar dapat dijatuhkan di tempat lain nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deposita file al notch e trascinali altrove più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチにドラッグしたファイルを一時的に置き、あとで別の場所にドロップできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치로 끌어온 파일을 보관했다가 나중에 다른 곳에 놓을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
