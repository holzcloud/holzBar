    "Hide the clock or Control Center, and keep Apple items one click away on macOS 27." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blende die Uhr oder das Kontrollzentrum aus und halte Apple-Elemente unter macOS 27 einen Klick entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el reloj o el Centro de control y deja los elementos de Apple a un clic en macOS 27."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez l’horloge ou le Centre de contrôle et gardez les éléments Apple à un clic sous macOS 27."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi l’orologio o il Centro di Controllo e tieni gli elementi Apple a un clic su macOS 27."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27 で、時計やコントロールセンターを非表示にしつつ、Apple の項目をワンクリックで使えるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 27에서 시계나 제어 센터를 숨기고, Apple 항목은 한 번의 클릭으로 열 수 있게 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte o relógio ou a Central de Controle e mantenha os itens da Apple a um clique no macOS 27."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuppenta l’ura u il center da controlla e tegna ils elements Apple a in clic sin macOS 27."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скройте часы или Пункт управления и оставьте элементы Apple в одном нажатии на macOS 27."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 macOS 27 上隐藏时钟或控制中心，并让 Apple 项目保持一键可用。"
          }
        }
      }
    },
