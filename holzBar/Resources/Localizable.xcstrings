    "“%@” already uses this combination. Use it here instead?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» verwendet diese Kombination schon. Stattdessen hier verwenden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
