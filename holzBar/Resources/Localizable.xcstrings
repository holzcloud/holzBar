    "The Menu Bar Layout pane shows pictures of your menu bar items, which macOS lets an app take only with Screen Recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bereich «Menüleistenlayout» zeigt Bilder deiner Menüleistenelemente, die eine App unter macOS nur mit der Bildschirmaufnahme erstellen darf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sous-fenêtre « Disposition de la barre des menus » affiche des images de vos éléments, que macOS ne laisse prendre qu'avec l'enregistrement de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello «Layout della barra dei menu» mostra immagini dei tuoi elementi, che macOS lascia acquisire solo con la registrazione schermo."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il champ «Disposiziun da la trav da menu» mussa maletgs da tes elements, ils quals macOS lascha far mo cun la Bildschirmaufnahme."
          }
        }
      }
    },
    "The amount of time to wait before showing on hover." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange gewartet wird, bevor per Zeiger eingeblendet wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps d'attente avant l'affichage au survol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di attesa prima della comparsa al passaggio del puntatore."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quant ditg ch'i vegn spetgà avant che mussar cun il cursur."
          }
        }
      }
    },
    "The camera and microphone indicator is hidden" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera- und Mikrofonanzeige ist ausgeblendet"
