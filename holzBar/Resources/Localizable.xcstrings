    "Save a look to switch back to it in one click, or from a rule." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte vzhled, abyste se k němu mohli vrátit jedním kliknutím nebo z pravidla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere ein Aussehen, um mit einem Klick oder per Regel dorthin zurückzukehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un aspecto para volver a él con un clic, o desde una regla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un aspect pour y revenir d’un clic, ou depuis une règle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsen egy kinézetet, hogy egy kattintással vagy egy szabályból visszaválthasson rá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan tampilan agar Anda dapat kembali ke sana dengan satu klik atau dari suatu aturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un aspetto per tornarci con un clic o da una regola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見た目を保存しておくと、ワンクリックで、またはルールから、その見た目に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모습을 저장해 두면 한 번의 클릭으로, 또는 규칙에서 다시 그 모습으로 전환할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een look om er met één klik naar terug te schakelen, of vanuit een regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj wygląd, aby wrócić do niego jednym kliknięciem lub z reguły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve um visual para voltar a ele com um clique, ou por uma regra."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorisescha in aspect per turnar tar el cun in clic u cun ina regla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните вид, чтобы вернуться к нему одним нажатием или из правила."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara ett utseende så att du kan byta tillbaka till det med ett klick eller från en regel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir görünümü kaydedin, böylece tek tıklamayla veya bir kuraldan ona geri dönebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть вигляд, щоб повернутися до нього одним клацанням або з правила."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储一个外观，即可一键切换回去，或通过规则切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存一個外觀，即可一鍵或透過規則切換回來。"
          }
        }
      }
    },
