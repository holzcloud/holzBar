    "%@\nShown only while the rule “%@” holds" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nZobrazeno jen dokud platí pravidlo „%@“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nNur sichtbar, solange die Regel «%@» gilt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisible solo mientras se cumpla la regla “%@”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nVisible seulement tant que la règle « %@ » est vraie"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCsak addig látható, amíg a(z) „%@” szabály érvényes"
          }
