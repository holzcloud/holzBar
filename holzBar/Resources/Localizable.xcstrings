    "holzBar may not use Bluetooth, so connection alerts are off." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar nesmí používat Bluetooth, proto jsou upozornění na připojení vypnutá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar darf Bluetooth nicht verwenden, deshalb sind Verbindungshinweise aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar no puede usar Bluetooth, así que los avisos de conexión están desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar n’a pas accès au Bluetooth ; les alertes de connexion sont désactivées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holzBar nem használhatja a Bluetoothot, ezért a csatlakozási riasztások ki vannak kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar tidak dapat menggunakan Bluetooth, jadi peringatan koneksi dimatikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar non può usare il Bluetooth, quindi gli avvisi di connessione sono disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は Bluetooth を使用できないため、接続の通知はオフです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar에서 Bluetooth를 사용할 수 없으므로 연결 알림이 꺼져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mag Bluetooth niet gebruiken, dus verbindingsmeldingen staan uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar nie może używać Bluetooth, więc alerty o połączeniu są wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar não pode usar o Bluetooth, então os avisos de conexão estão desativados."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar na dastga betg duvrar Bluetooth, perquai èn las avertenzas da colliaziun deactivadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar не может использовать Bluetooth, поэтому оповещения о подключении отключены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar kan inte använda Bluetooth, så anslutningsvarningar är avstängda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar Bluetooth’u kullanamıyor, bu yüzden bağlantı uyarıları kapalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar не може використовувати Bluetooth, тому сповіщення про підключення вимкнено."
          }
