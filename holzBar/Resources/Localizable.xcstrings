    "Asks for access to your Downloads folder when you switch it on. holzBar never reads what you download." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zapnutí požádá o přístup ke složce Stažené. holzBar nikdy nečte, co stahujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt beim Einschalten nach Zugriff auf deinen Downloads-Ordner. holzBar liest nie, was du lädst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide acceso a tu carpeta Descargas al activarlo. holzBar nunca lee lo que descargas."
