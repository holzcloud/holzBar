    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar liest, welche deiner gekoppelten Bluetooth-Geräte verbunden sind, damit eine Automatisierungsregel darauf reagieren kann. Das geschieht nur, solange eine Regel diese Bedingung verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar reads which of your paired Bluetooth devices are connected, so an automation rule can react to it. It only does so while a rule uses this condition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lee cuáles de tus dispositivos Bluetooth vinculados están conectados para que una regla de automatización pueda reaccionar. Solo lo hace mientras una regla usa esta condición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lit lesquels de vos appareils Bluetooth appairés sont connectés afin qu’une règle d’automatisation puisse y réagir. Cela n’a lieu que tant qu’une règle utilise cette condition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legge quali dei tuoi dispositivi Bluetooth associati sono connessi, in modo che una regola di automazione possa reagire. Lo fa solo finché una regola usa questa condizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、オートメーションルールが反応できるように、ペアリング済みの Bluetooth デバイスのうちどれが接続中かを読み取ります。ルールがこの条件を使用している間だけ読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 자동화 규칙이 반응할 수 있도록 페어링된 Bluetooth 기기 중 어떤 기기가 연결되어 있는지 읽습니다. 규칙이 이 조건을 사용하는 동안에만 읽습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar lê quais dos seus dispositivos Bluetooth pareados estão conectados para que uma regra de automação possa reagir. Ele só faz isso enquanto uma regra usa esta condição."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legia tge apparats Bluetooth associads che èn colliads, uschia che ina regla d’automatisaziun po reagir. Quai capita mo uschè ditg che ina regla utilisescha questa cundiziun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar считывает, какие из ваших сопряжённых устройств Bluetooth подключены, чтобы правило автоматизации могло на это реагировать. Это происходит только пока правило использует это условие."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会读取你已配对的蓝牙设备中哪些已连接，以便自动化规则可以据此做出反应。仅在有规则使用此条件期间才会读取。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Calendar usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar zeigt deine nächsten Termine und ihre Meeting-Links im Notch-Hub. Sie werden nur auf diesem Mac gelesen und nie gesendet oder gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar shows your next events and their meeting links in the notch hub. It reads them on this Mac only and never sends or stores them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar muestra tus próximos eventos y sus enlaces de reunión en el centro del notch. Los lee solo en este Mac y nunca los envía ni los guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar affiche vos prochains événements et leurs liens de réunion dans le hub de l’encoche. Ils sont lus uniquement sur ce Mac et ne sont jamais envoyés ni enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mostra i tuoi prossimi eventi e i relativi link delle riunioni nell’hub del notch. Vengono letti solo su questo Mac e non vengono mai inviati né salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、次の予定とその会議リンクをノッチハブに表示します。予定はこの Mac 上でのみ読み取られ、送信や保存は一切行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 노치 허브에 다음 일정과 회의 링크를 표시합니다. 일정은 이 Mac에서만 읽으며 전송하거나 저장하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar mostra seus próximos eventos e os links de reunião deles no hub do notch. Ele os lê somente neste Mac e nunca os envia nem os armazena."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mussa tes proxims eveniments e lur colligaziuns da scuntradas en il hub da la notch. Els vegnan legids mo sin quest Mac e mai trametti u memorisads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar показывает ваши ближайшие события и ссылки на встречи в центре у выреза. События читаются только на этом Mac и никогда не отправляются и не сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会在刘海中心里显示你接下来的日程及其会议链接。日程仅在这台 Mac 上读取，绝不会发送或存储。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
