    "NSDownloadsFolderUsageDescription" : {
      "comment" : "Downloads folder usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar watches your Downloads folder for downloads in progress, to show them at the notch. It never reads what you download."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar beobachtet deinen Ordner „Downloads“ auf laufende Downloads, um sie an der Notch anzuzeigen. Was du lädst, wird nie gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar vigila tu carpeta Descargas para detectar las descargas en curso y mostrarlas en el notch. Nunca lee lo que descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar surveille votre dossier Téléchargements pour repérer les téléchargements en cours et les afficher à l’encoche. Il ne lit jamais ce que vous téléchargez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar osserva la tua cartella Download per rilevare i download in corso e mostrarli sulla notch. Non legge mai ciò che scarichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、進行中のダウンロードをノッチに表示するために、ダウンロードフォルダを監視します。ダウンロードした内容は読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 진행 중인 다운로드를 노치에 표시하기 위해 다운로드 폴더를 감시합니다. 다운로드한 내용은 읽지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar observa a sua pasta Downloads para detectar downloads em andamento e mostrá-los no notch. Ele nunca lê o que você baixa."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar observescha tia mappa «Downloads» per mussar las telechargiadas en andament tar la notch. Quai che ti telechargias na vegn mai legì."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar следит за папкой «Загрузки», чтобы показывать текущие загрузки у выреза. Содержимое загружаемых файлов не читается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会监视你的“下载”文件夹，以便在刘海处显示正在进行的下载。它不会读取你下载的内容。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar houdt je map Downloads in de gaten voor downloads die bezig zijn, om ze bij de notch te tonen. Het leest nooit wat je downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar obserwuje Twój folder Pobrane pod kątem trwających pobrań, aby pokazać je przy notchu. Nigdy nie odczytuje tego, co pobierasz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar sleduje vaši složku Stažené kvůli probíhajícímu stahování, aby ho zobrazil u výřezu. Nikdy nečte, co stahujete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holzBar figyeli a Letöltések mappáját a folyamatban lévő letöltések miatt, hogy megjelenítse őket a notchnál. Soha nem olvassa, amit letölt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar bevakar din mapp Hämtade filer efter pågående hämtningar för att visa dem vid notchen. Den läser aldrig det du hämtar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar sürmekte olan indirmeler için İndirilenler klasörünüzü izler ve onları notch’ta gösterir. İndirdiklerinizi asla okumaz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar memantau folder Unduhan Anda untuk unduhan yang sedang berlangsung agar dapat menampilkannya di notch. holzBar tidak pernah membaca apa yang Anda unduh."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar стежить за папкою «Завантаження», щоб показувати поточні завантаження біля вирізу. Вміст завантажуваних файлів не читається."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 會監看你的「下載項目」檔案夾，以便在瀏海旁顯示進行中的下載。它絕不會讀取你下載的內容。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Location usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar čte název sítě Wi-Fi, ke které jste připojeni, aby na něj mohlo pravidlo automatizace reagovat. Nečte vaši polohu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar liest den Namen des WLAN-Netzwerks, mit dem du verbunden bist, damit eine Automatisierungsregel darauf reagieren kann. Dein Standort wird nicht gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar reads the name of the Wi-Fi network you are connected to, so an automation rule can react to it. It does not read your location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lee el nombre de la red Wi-Fi a la que estás conectado para que una regla de automatización pueda reaccionar a él. No lee tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lit le nom du réseau Wi-Fi auquel vous êtes connecté afin qu’une règle d’automatisation puisse y réagir. Votre position n’est pas lue."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holzBar beolvassa annak a Wi-Fi hálózatnak a nevét, amelyhez csatlakozik, hogy egy automatizálási szabály reagálhasson rá. A tartózkodási helyét nem olvassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar membaca nama jaringan Wi-Fi yang terhubung dengan Anda agar aturan otomatisasi dapat bereaksi terhadapnya. holzBar tidak membaca lokasi Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legge il nome della rete Wi-Fi a cui sei connesso, così una regola di automazione può reagire. La tua posizione non viene letta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、接続している Wi-Fi ネットワークの名前を読み取り、オートメーションルールがそれに反応できるようにします。位置情報は読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 자동화 규칙이 반응할 수 있도록 연결된 Wi-Fi 네트워크의 이름을 읽습니다. 사용자의 위치는 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar leest de naam van het wifi-netwerk waarmee je bent verbonden, zodat een automatiseringsregel erop kan reageren. Het leest je locatie niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar odczytuje nazwę sieci Wi-Fi, z którą jesteś połączony, aby reguła automatyzacji mogła na nią zareagować. Nie odczytuje Twojej lokalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar lê o nome da rede Wi-Fi à qual você está conectado para que uma regra de automação possa reagir a ele. Ele não lê a sua localização."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legia il num da la rait WLAN cun la quala ti es collià, per che ina regla d’automatisaziun possia reagir. Tia posiziun na vegn betg legida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar считывает название сети Wi-Fi, к которой вы подключены, чтобы правило автоматизации могло на неё реагировать. Местоположение не считывается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar läser namnet på Wi-Fi-nätverket du är ansluten till så att en automationsregel kan reagera på det. Den läser inte din plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar, bir otomasyon kuralının tepki verebilmesi için bağlı olduğunuz Wi-Fi ağının adını okur. Konumunuzu okumaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar зчитує назву мережі Wi-Fi, до якої ви підключені, щоб правило автоматизації могло на неї реагувати. Локація не зчитується."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会读取你所连接的 Wi-Fi 网络的名称，以便自动化规则可以据此做出反应。它不会读取你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 會讀取你所連接之 Wi-Fi 網路的名稱，讓自動化規則可以對它做出反應。它不會讀取你的位置。"
          }
        }
      }
    },
