    "NSLocationUsageDescription" : {
      "comment" : "Location usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar liest den Namen des WLAN-Netzwerks, mit dem du verbunden bist, damit eine Automatisierungsregel darauf reagieren kann. Dein Standort wird nicht gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar reads the name of the Wi-Fi network you are connected to, so an automation rule can react to it. It does not read your location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lee el nombre de la red Wi-Fi a la que estás conectado para que una regla de automatización pueda reaccionar a él. No lee tu ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar lit le nom du réseau Wi-Fi auquel vous êtes connecté afin qu’une règle d’automatisation puisse y réagir. Votre position n’est pas lue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legge il nome della rete Wi-Fi a cui sei connesso, così una regola di automazione può reagire. La tua posizione non viene letta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、接続している Wi-Fi ネットワークの名前を読み取り、オートメーションルールがそれに反応できるようにします。位置情報は読み取りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 자동화 규칙이 반응할 수 있도록 연결된 Wi-Fi 네트워크의 이름을 읽습니다. 사용자의 위치는 읽지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar lê o nome da rede Wi-Fi à qual você está conectado para que uma regra de automação possa reagir a ele. Ele não lê a sua localização."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar legia il num da la rait WLAN cun la quala ti es collià, per che ina regla d’automatisaziun possia reagir. Tia posiziun na vegn betg legida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar считывает название сети Wi-Fi, к которой вы подключены, чтобы правило автоматизации могло на неё реагировать. Местоположение не считывается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会读取你所连接的 Wi-Fi 网络的名称，以便自动化规则可以据此做出反应。它不会读取你的位置。"
          }
        }
      }
    },
