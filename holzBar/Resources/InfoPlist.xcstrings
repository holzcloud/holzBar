    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar sieht, welche deiner gekoppelten Bluetooth-Geräte verbunden sind, damit Automatisierungsregeln und Zubehör-Hinweise darauf reagieren können. Es verbindet sich nie mit einem Gerät, sucht keine Geräte und sendet nichts an ein Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar sees which of your paired Bluetooth devices are connected, so automation rules and accessory alerts can react to it. It never connects to a device, scans for devices or sends anything to one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar ve cuáles de tus dispositivos Bluetooth vinculados están conectados para que las reglas de automatización y los avisos de accesorios puedan reaccionar. Nunca se conecta a un dispositivo, busca dispositivos ni envía nada a ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar voit lesquels de vos appareils Bluetooth jumelés sont connectés afin que les règles d’automatisation et les alertes d’accessoires puissent y réagir. Elle ne se connecte jamais à un appareil, n’en recherche pas et ne lui envoie rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar vede quali dei tuoi dispositivi Bluetooth associati sono connessi, così le regole di automazione e gli avvisi degli accessori possono reagire. Non si connette mai a un dispositivo, non ne cerca e non invia nulla a un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、オートメーションルールやアクセサリの通知が反応できるように、ペアリング済みの Bluetooth デバイスのうちどれが接続中かを確認します。デバイスに接続したり、デバイスを検索したり、デバイスに何かを送信したりすることは一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 자동화 규칙과 액세서리 알림이 반응할 수 있도록 페어링된 Bluetooth 기기 중 어떤 기기가 연결되어 있는지 확인합니다. 기기에 연결하거나 기기를 검색하거나 기기로 무언가를 보내는 일은 절대 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar ziet welke van je gekoppelde Bluetooth-apparaten zijn verbonden, zodat automatiseringsregels en accessoiremeldingen erop kunnen reageren. Het maakt nooit verbinding met een apparaat, zoekt niet naar apparaten en stuurt niets naar een apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar vê quais dos seus dispositivos Bluetooth pareados estão conectados para que as regras de automação e os avisos de acessórios possam reagir. Ele nunca se conecta a um dispositivo, procura dispositivos nem envia nada a nenhum."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar vesa tgenins da tes apparats Bluetooth colliads èn collià, per che las reglas d’automatisaziun e las avertenzas dals accessoris possian reagir. El na sa collia mai cun in apparat, na tschertga nagins apparats e na trametta nagut a in apparat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar видит, какие из ваших сопряжённых устройств Bluetooth подключены, чтобы правила автоматизации и оповещения об аксессуарах могли на это реагировать. Он никогда не подключается к устройствам, не ищет их и ничего им не отправляет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会查看你已配对的蓝牙设备中哪些已连接，以便自动化规则和配件提醒可以据此做出反应。它绝不会连接设备、搜索设备或向设备发送任何内容。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Calendar usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar zeigt deine nächsten Termine und ihre Meeting-Links im Notch-Hub. Sie werden nur auf diesem Mac gelesen und nie gesendet oder gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "holzBar shows your next events and their meeting links in the notch hub. It reads them on this Mac only and never sends or stores them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar muestra tus próximos eventos y sus enlaces de reunión en el centro del notch. Los lee solo en este Mac y nunca los envía ni los guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar affiche vos prochains événements et leurs liens de réunion dans le hub de l’encoche. Ils sont lus uniquement sur ce Mac et ne sont jamais envoyés ni enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mostra i tuoi prossimi eventi e i relativi link delle riunioni nell’hub del notch. Vengono letti solo su questo Mac e non vengono mai inviati né salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar は、次の予定とその会議リンクをノッチハブに表示します。予定はこの Mac 上でのみ読み取られ、送信や保存は一切行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar는 노치 허브에 다음 일정과 회의 링크를 표시합니다. 일정은 이 Mac에서만 읽으며 전송하거나 저장하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar toont je volgende afspraken en hun vergaderlinks in de notch-hub. Het leest ze alleen op deze Mac en verzendt of bewaart ze nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O holzBar mostra seus próximos eventos e os links de reunião deles no hub do notch. Ele os lê somente neste Mac e nunca os envia nem os armazena."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar mussa tes proxims eveniments e lur colligaziuns da scuntradas en il hub da la notch. Els vegnan legids mo sin quest Mac e mai trametti u memorisads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar показывает ваши ближайшие события и ссылки на встречи в центре у выреза. События читаются только на этом Mac и никогда не отправляются и не сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "holzBar 会在刘海中心里显示你接下来的日程及其会议链接。日程仅在这台 Mac 上读取，绝不会发送或存储。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
